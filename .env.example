# ============ Supabase ============
# Créez un projet sur https://supabase.com puis récupérez ces valeurs dans :
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-anon-key-publique"
# Clé service_role (Settings → API → service_role) — pour uploads Storage (contourne RLS). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY="votre-service-role-key-secrete"

# Connexion PostgreSQL (Prisma)
# Dashboard → Project Settings → Database → Connection string
# Pooler (port 6543) — pour dev local si la connexion directe 5432 ne passe pas. Ajouter ?pgbouncer=true à la fin.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion DIRECTE (5432) — surtout pour `prisma migrate` / `db push` (`directUrl` dans schema.prisma).
# L’application utilise en priorité DATABASE_URL (pooler) pour les requêtes.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# ============ NextAuth ============
NEXTAUTH_SECRET="votre-secret-genere-32-caracteres"
# Identique au domaine où les utilisateurs ouvrent le site (magic link + cookie). Éviter mélange localhost / 127.0.0.1.
NEXTAUTH_URL="http://localhost:3000"
# Recommandé : même valeur d’origine que NEXTAUTH_URL pour les liens dans les mails.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Secret pour appeler une fois /api/admin/update-demo-passwords?secret=XXX (mise à jour mots de passe démo)
# UPDATE_DEMO_PASSWORDS_SECRET="un-secret-aleatoire"

# ============ Contact (formulaire + envoi email) ============
# Adresse qui reçoit les demandes (une ou plusieurs séparées par des virgules)
CONTACT_EMAIL="contact@votredomaine.fr"
# Email interne : notification à chaque inscription (une ou plusieurs séparées par des virgules)
ADMIN_NOTIFICATION_EMAIL="bework.f@gmail.com"
#
# --- Option A : SMTP (sans Resend) — ex. Gmail avec "mot de passe d'application"
# Si SMTP_HOST est défini + user/pass, l'app envoie d'abord via SMTP ; Resend sert de secours si SMTP échoue.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="votre.compte@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM_EMAIL="votre.compte@gmail.com"
# SMTP_FROM_NAME="BeWork"
#
# --- Option B : Resend : https://resend.com — clé API pour envoyer les emails
RESEND_API_KEY="re_xxxx"
# Expéditeur : doit être un domaine AJOUTÉ ET VÉRIFIÉ dans Resend (DNS), sinon l’API renvoie une erreur.
RESEND_FROM_EMAIL="noreply@votredomaine.fr"
RESEND_FROM_NAME="BeWork"
# Si le mail ne part pas : Railway → Logs (cherche [contact] Resend) ; Resend → Domains (vérification OK).

# ============ SEO & visibilité (optionnel) ============
# URL canonique du site (obligatoire en prod pour sitemap, Open Graph, JSON-LD)
# NEXT_PUBLIC_SITE_URL="https://votredomaine.fr"
# Vérification Google Search Console (balise meta)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="code-fourni-par-google"
# Profils à lier dans le schéma Organization (JSON-LD) : URLs séparées par des virgules
# NEXT_PUBLIC_ORG_SAME_AS="https://www.linkedin.com/company/votre-page,https://..."
# Twitter / X — handles pour les cartes (ex. @BeWork)
# NEXT_PUBLIC_TWITTER_SITE="@BeWork"
# NEXT_PUBLIC_TWITTER_CREATOR="@BeWork"

# ============ Outils de communication (optionnel) ============
# Numéro WhatsApp Business (sans +) pour le lien "WhatsApp" dans le header du dashboard.
# Exemple : 33600000000 pour la France
# NEXT_PUBLIC_WHATSAPP_NUMBER="33600000000"

