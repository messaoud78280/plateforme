# ============ Supabase ============
# Créez un projet sur https://supabase.com puis récupérez ces valeurs dans :
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-anon-key-publique"

# Connexion PostgreSQL (Prisma)
# Dashboard → Project Settings → Database → Connection string
# Choisir "URI" et copier. Remplacez [YOUR-PASSWORD] par le mot de passe de la base.
# Pour le pooler (recommandé pour l'app) : port 6543
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Connexion DIRECTE (port 5432) — utilisée par l'app (local + production) et par prisma db push.
# Obligatoire pour éviter les erreurs "prepared statement" avec le pooler (port 6543).
# Même host/mot de passe que DATABASE_URL, seul le port change : 5432 au lieu de 6543.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ============ NextAuth ============
NEXTAUTH_SECRET="votre-secret-genere-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ============ Contact (formulaire + envoi email) ============
# Adresse qui reçoit les demandes de contact (obligatoire pour /contact)
CONTACT_EMAIL="contact@votredomaine.fr"
# Resend : https://resend.com — clé API pour envoyer les emails
RESEND_API_KEY="re_xxxx"
# Expéditeur des emails (domaine vérifié sur Resend)
RESEND_FROM_EMAIL="noreply@votredomaine.fr"
RESEND_FROM_NAME="IATASK"

# ============ Outils de communication (optionnel) ============
# Numéro WhatsApp Business (sans +) pour le lien "WhatsApp" dans le header du dashboard.
# Exemple : 33600000000 pour la France
# NEXT_PUBLIC_WHATSAPP_NUMBER="33600000000"
