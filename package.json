{
  "name": "plateforme",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true NODE_TLS_REJECT_UNAUTHORIZED=0 next dev --webpack --hostname 127.0.0.1 --port 3000",
    "dev:turbo": "NODE_TLS_REJECT_UNAUTHORIZED=0 next dev --turbopack --hostname 127.0.0.1 --port 3000",
    "dev:3001": "WATCHPACK_POLLING=true NODE_TLS_REJECT_UNAUTHORIZED=0 next dev --webpack --hostname 127.0.0.1 --port 3001",
    "db:push": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx prisma db push",
    "db:setup": "echo '→ Création des tables...' && npm run db:push && echo '→ Création des comptes...' && npm run db:seed && echo '→ Terminé.'",
    "build": "npx prisma generate && NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "postbuild": "npm run --silent seo:ping-indexnow || true",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "lint": "eslint",
    "db:seed": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx prisma/seed.ts",
    "db:seed:equipe": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx prisma/seed-equipe-bework.ts",
    "db:reset-equipe": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/reset-bework-team-access.ts",
    "db:seed:devis": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx prisma/seed-bework-devis.ts",
    "db:check": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/verifier-supabase.ts",
    "db:update-demo-passwords": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/update-demo-passwords.ts",
    "db:backfill-work-item-descriptions": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/backfill-work-item-descriptions.ts",
    "db:backfill-project-lifecycle": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/backfill-project-lifecycle-status.ts",
    "db:normalize-work-item-lots": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/normalize-work-item-lots.ts",
    "db:harmonize-lots-remote": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/run-remote-harmonization.ts --apply",
    "test:demo-environment": "node --import tsx scripts/test-demo-environment.ts",
    "test:follow-up-attention": "npx tsx scripts/test-follow-up-attention.ts",
    "test:a-traiter-board": "npx tsx scripts/test-a-traiter-board.ts",
    "test:chantier-cockpit-ops": "npx tsx scripts/test-chantier-cockpit-ops.ts",
    "test:attention-notifications": "npx tsx scripts/test-attention-notifications.ts",
    "test:attention-escalation": "npx tsx scripts/test-attention-escalation.ts",
    "test:attention-scheduler": "npx tsx scripts/test-attention-scheduler.ts",
    "test:purchase-orders": "npx tsx scripts/test-purchase-orders.ts",
    "test:purchase-order-attention": "npx tsx scripts/test-purchase-order-attention.ts",
    "test:purchase-order-attention-notifications": "npx tsx scripts/test-purchase-order-attention-notifications.ts",
    "test:agenda-v2a": "npx tsx scripts/test-agenda-v2a.ts",
    "test:messagerie-v2c-media": "npx tsx scripts/test-messagerie-v2c-media.ts",
    "test:messagerie-v2c1-hardening": "npx tsx scripts/test-messagerie-v2c1-hardening.ts",
    "migrate:messagerie-legacy-media": "npx tsx scripts/migrate-messagerie-legacy-media.ts",
    "test:messagerie-v2c2-legacy-migrate": "npx tsx scripts/test-messagerie-v2c2-legacy-migrate.ts",
    "process:attention-escalations": "npx tsx scripts/process-attention-escalations.ts",
    "notifications:run-attention-escalations": "npx tsx scripts/run-attention-escalations.ts",
    "db:cleanup-chantier-resources": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/run-chantier-resource-cleanup.ts",
    "db:sync-chantier-from-library": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/sync-library-to-chantier.ts",
    "db:studio": "prisma studio",
    "deploy": "bash scripts/deploy-railway.sh",
    "deploy:login": "npx --yes @railway/cli login",
    "deploy:login:browserless": "npx --yes @railway/cli login --browserless",
    "deploy:logs": "npx --yes @railway/cli logs --service plateforme --environment production",
    "seo:ping-indexnow": "npx tsx scripts/ping-indexnow-seo.ts",
    "notifications:run-relances": "npx tsx scripts/run-relances.ts",
    "render:conciergerie-ui": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx scripts/render-conciergerie-ui.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-virtual": "^3.14.9",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "jspdf": "^4.1.0",
    "libreoffice-convert": "^1.8.1",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
