{
  "name": "plateforme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 next dev --hostname 127.0.0.1 --port 3000",
    "dev:3001": "NODE_TLS_REJECT_UNAUTHORIZED=0 next dev --hostname 127.0.0.1 --port 3001",
    "db:push": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx prisma db push",
    "db:setup": "echo '→ Création des tables...' && npm run db:push && echo '→ Création des comptes...' && npm run db:seed && echo '→ Terminé.'",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "db:seed": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx prisma/seed.ts",
    "db:seed:simulation": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx prisma/seed-simulation.ts",
    "db:check": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/verifier-supabase.ts",
    "db:update-demo-passwords": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx scripts/update-demo-passwords.ts",
    "db:studio": "prisma studio",
    "deploy": "npx --yes @railway/cli up"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.95.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "jspdf": "^4.1.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "pg": "^8.18.0",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "resend": "^6.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
