model DemoEnvironment {
  id              String    @id @default(cuid())
  companyName     String
  internalName    String
  sector          String?
  employeeCount   Int?
  logoUrl         String?
  /// PME_BTP | CHANTIER_TERRAIN | MARCHES_ETUDES | ENTREPRISE_GENERALE
  templateKey     String    @default("PME_BTP")
  /// Modules visibles (string[])
  modulesEnabled  Json
  /// Profils fictifs affichés [{ name, roleLabel }]
  rolesConfig     Json?
  /// Terminologie optionnelle { projectsLabel?: string }
  terminology     Json?
  meetingAt       DateTime?
  startsAt        DateTime  @default(now())
  expiresAt       DateTime
  /// ACTIVE | DISABLED | EXPIRED | ARCHIVED
  status          String    @default("ACTIVE")
  lastLoginAt     DateTime?
  /// Identifiant public (ex. abc-etancheite) — email technique = {id}@demo.bework.local
  loginIdentifier String    @unique
  rootUserId      String    @unique
  organizationId  String?   @unique
  seedVersion     String    @default("v1")
  notes           String?   @db.Text
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rootUser     User          @relation("DemoEnvironmentRootUser", fields: [rootUserId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("DemoEnvironmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@index([createdById])
  @@index([companyName])
  @@index([templateKey])
}

