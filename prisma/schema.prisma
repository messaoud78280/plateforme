  alertNotifiedAt   DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pilotage WorksitePilotage @relation(fields: [pilotageId], references: [id], onDelete: Cascade)

  @@index([pilotageId, status])
  @@index([pilotageId, dueDate])
  @@index([priority])
}

model RequiredDocument {
  id                  String    @id @default(cuid())
  pilotageId          String
  name                String
  category            String    @default("Administratif")
  sourceDocument      String?
  isMandatory         Boolean   @default(true)
  producerName        String?
  validatorName       String?
  recipient           String?
  requestedAt         DateTime? @db.Date
  dueDate             DateTime? @db.Date
  receivedAt          DateTime? @db.Date
  sentAt              DateTime? @db.Date
  validatedAt         DateTime? @db.Date
  version             String?
  status              String    @default("Manquant")
  comment             String?   @db.Text
  fileUrl             String?
  proofUrl            String?
  alertNotifiedAt     DateTime?
  archivedAt          DateTime?
