// Plateforme d'échange Client - Agence
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Utilisateurs (clients et membres de l'agence)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  emailVerified DateTime?
  civilite  String?  // Civilité : M., Mme, etc.
  role      UserRole @default(CLIENT)
  company   String?  // Raison sociale
  phone     String?
  // Adresse de facturation (coordonnées entreprise)
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingPostalCode   String?
  billingCountry      String?
  formeJuridique  String?  // SAS, EURL, SARL, SA, profession libérale, etc.
  secteurActivite String?  // e-commerce, juridique, commercial, etc.
  service         String?  // Service / département du contact
  // Validation inscription client (inscription publique → PENDING_APPROVAL)
  accountStatus   ClientAccountStatus @default(APPROVED)
  approvedAt      DateTime?
  approvedById    String?
  // Signature électronique du contrat (activation compte)
  contractStatus  ContractStatus @default(PENDING)
  signedAt        DateTime?
  yousignSignatureRequestId String?  // ID de la demande Yousign
  // Facturation par actions (1 action = 12 min, 5 actions ≈ 1 h)
  subscriptionPlan   String?   // STANDARD | STANDARD_PLUS | PREMIUM | FULLTIME
  monthlyActionsTotal Int      @default(120)  // selon abonnement
  monthlyActionsUsed  Int      @default(0)    // consommées ce mois
  actionsResetAt      DateTime? // expiration des crédits en cours (J+30 après achat/crédit)
  invitedById         String?   // utilisateur qui a invité (équipe)
  teamRole            String?   // ADMIN | USER | SUPERVISEUR (si membre d'une équipe)
  /// Type métier dans l’écosystème entreprise (V1 Utilisateurs & accès)
  personType          String?   // INTERNAL | CLIENT_EXT | SUPPLIER | SUBCONTRACTOR | MOE | CONTROL_OFFICE | PARTNER
  /// Statut d’accès plateforme
  accessStatus        String    @default("ACTIVE") // ACTIVE | INVITED | SUSPENDED | DISABLED
  /// Profil de permissions prédéfini
  permissionProfile   String?   // DIRECTION | ADMINISTRATIF | CONDUCTEUR | CHEF_CHANTIER | CLIENT | FOURNISSEUR | SOUS_TRAITANT | PARTENAIRE
  jobTitle            String?   // Fonction affichée
  mustChangePassword  Boolean   @default(false)
  lastLoginAt         DateTime?
  externalOrganizationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invitedBy           User?     @relation("TeamMembers", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers        User[]    @relation("TeamMembers")
  externalOrganization ExternalOrganization? @relation("ExternalOrgPeople", fields: [externalOrganizationId], references: [id], onDelete: SetNull)
  externalOrgContacts ExternalOrgContact[] @relation("ExternalOrgContactUser")
  purchaseOrdersRequested  PurchaseOrder[] @relation("PurchaseOrderRequestedBy")
  purchaseOrdersResponsible PurchaseOrder[] @relation("PurchaseOrderResponsible")
  purchaseOrdersValidator   PurchaseOrder[] @relation("PurchaseOrderValidator")
  purchaseOrderEvents       PurchaseOrderEvent[] @relation("PurchaseOrderEventActor")
  purchaseOrderReceipts     PurchaseOrderReceipt[] @relation("PurchaseOrderReceiptReceivedBy")
  projectAccesses     ProjectAccess[] @relation("ProjectAccessUser")
  projectAccessesGranted ProjectAccess[] @relation("ProjectAccessGrantedBy")
  accessAuditsAsActor AccessAuditLog[] @relation("AccessAuditActor")
  accessAuditsAsTarget AccessAuditLog[] @relation("AccessAuditTarget")
  approvedBy          User?     @relation("ApprovedClients", fields: [approvedById], references: [id], onDelete: SetNull)
  clientsApproved     User[]    @relation("ApprovedClients")
  invitationsSent     Invitation[]
  messagesSent       Message[]  @relation("SentMessages")
  messagesReceived   Message[]  @relation("ReceivedMessages")
  messageChannelReceipts MessageChannelReceipt[] @relation("MessageChannelReceipts")
  projectChannelParticipants ProjectChannelParticipant[] @relation("ProjectChannelParticipants")
  projectChannelParticipantsAdded ProjectChannelParticipant[] @relation("ProjectChannelParticipantAddedBy")
  projects           Project[]  @relation("ClientProjects")
  projectsAssigned   Project[]  @relation("AssignedProjects")
  documents          Document[]
  tasks              Task[]
  tasksAssigned      Task[]     @relation("AssignedTasks")
  tasksCreated       Task[]     @relation("TasksCreatedBy")
  taskComments       TaskComment[]
  taskMessagesSent   TaskMessage[]  @relation("TaskMessagesSent")
  taskMessagesReceived TaskMessage[] @relation("TaskMessagesReceived")
  directMessagesSent   DirectMessage[] @relation("DirectMessagesSent")
  directMessagesReceived DirectMessage[] @relation("DirectMessagesReceived")
  messageHides         MessageUserHide[]
  notifications      Notification[]
  activities         Activity[]
  alerts             Alert[]
  appointmentsOrganized Appointment[] @relation("AppointmentOrganizer")
  appointmentsAsClient  Appointment[] @relation("AppointmentClient")
  agendaEventsOwned     AgendaEvent[] @relation("AgendaEventOwner")
  agendaEventsCreated   AgendaEvent[] @relation("AgendaEventCreatedBy")
  agendaEventsResponsible AgendaEvent[] @relation("AgendaEventResponsible")
  agendaEventAttendances AgendaEventAttendee[]
  followUpSheetsOwned   FollowUpSheet[] @relation("FollowUpSheetOwner")
  followUpSheetsCreated FollowUpSheet[] @relation("FollowUpSheetCreatedBy")
  followUpSheetsAssigned FollowUpSheet[] @relation("FollowUpSheetAssignee")
  followUpTimelineAuthored FollowUpTimelineEvent[] @relation("FollowUpTimelineAuthor")
  followUpAlertSettings FollowUpAlertSettings? @relation("FollowUpAlertSettingsOwner")
  messageActionsAssigned MessageAction[] @relation("MessageActionAssignee")
  messageActionsCreated  MessageAction[] @relation("MessageActionCreatedBy")
  messageActionsCompleted MessageAction[] @relation("MessageActionCompletedBy")
  reportsAuthored       Report[]      @relation("ReportAuthor")
  reportComments        ReportComment[]
  subscriptions         Subscription[]
  payments              Payment[]
  actionsTransactions   ActionsTransaction[]
  skillCctpSessions     SkillCctpSession[]
  skillPpspsSessions    SkillPpspsSession[]
  chantierFiles         ChantierFile[]
  chantierFilesAdded    ChantierFile[] @relation("ChantierFileAddedBy")
  chantierFileComments  ChantierFileComment[] @relation("ChantierFileCommentAuthor")
  chantierFileFavorites ChantierFileFavorite[]
  materialRequirementsCreated  MaterialRequirement[] @relation("MaterialRequirementCreatedBy")
  materialRequirementsValidated MaterialRequirement[] @relation("MaterialRequirementValidatedBy")
  commercialQuotesCreated      CommercialQuote[] @relation("CommercialQuoteCreatedBy")
  commercialQuotesResponsible  CommercialQuote[] @relation("CommercialQuoteResponsible")
  commercialInvoicesCreated    CommercialInvoice[] @relation("CommercialInvoiceCreatedBy")
  commercialPaymentsRecorded   CommercialPayment[] @relation("CommercialPaymentRecordedBy")
  commercialStatusEvents       CommercialStatusEvent[] @relation("CommercialStatusEventActor")

  // Pilotage administratif des travaux
  worksitePilotagesCreated   WorksitePilotage[] @relation("PilotageCreatedBy")
  worksitePilotagesConducteur WorksitePilotage[] @relation("PilotageConducteur")
  worksitePilotagesAssistant WorksitePilotage[] @relation("PilotageAssistant")
  pilotageActionsAssigned    PilotageAction[]   @relation("PilotageActionAssignee")
  pilotageActionsCreated     PilotageAction[]   @relation("PilotageActionCreator")
  demoPilotageLinksCreated  DemoPilotageLink[] @relation("DemoPilotageLinkCreatedBy")
  demoEnvironmentsOwned     DemoEnvironment[]  @relation("DemoEnvironmentRootUser")
  demoEnvironmentsCreated   DemoEnvironment[]  @relation("DemoEnvironmentCreatedBy")

  // Organisation multi-utilisateurs
  organizationsOwned     Organization[]       @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]

  // NextAuth (magic link)
  accounts              Account[]
  sessions              Session[]
}

// NextAuth — comptes (OAuth, etc.)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth — sessions (si strategy database)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth — tokens de vérification (magic link)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
// Invitation à rejoindre l'équipe d'un client
model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        String   // ADMIN | USER | SUPERVISEUR (legacy org member)
  invitedById String
  token       String   @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  /// V1 Utilisateurs & accès
  personType         String?
  permissionProfile  String?
  firstName          String?
  lastName           String?
  companyName        String?
  phone              String?
  jobTitle           String?
  projectIdsJson     Json?
  externalOrganizationId String?

  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([invitedById])
  @@index([email, status])
}

/// Organisation externe (fournisseur, client, sous-traitant…) rattachée au tenant BeWork.
model ExternalOrganization {
  id                 String   @id @default(cuid())
  hostOrganizationId String
  name               String
  type               String   // CLIENT_EXT | SUPPLIER | SUBCONTRACTOR | MOE | CONTROL_OFFICE | PARTNER
  /// Nom commercial (ex. Point.P)
  tradeName          String?
  siret              String?
  address            String?
  city               String?
  zipCode            String?
  phone              String?
  email              String?
  website            String?
  /// Familles de produits / activité
  activity           String?
  paymentTerms       String?
  deliveryTerms      String?
  notes              String?  @db.Text
  /// ACTIVE | INACTIVE
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hostOrganization Organization @relation(fields: [hostOrganizationId], references: [id], onDelete: Cascade)
  people           User[]       @relation("ExternalOrgPeople")
  contacts         ExternalOrgContact[]
  purchaseOrders   PurchaseOrder[]
  projectChannels  ProjectChannel[]
  commercialQuotesAsClient CommercialQuote[] @relation("CommercialQuoteClient")
  commercialInvoicesAsClient CommercialInvoice[] @relation("CommercialInvoiceClient")

  @@index([hostOrganizationId])
  @@index([hostOrganizationId, type])
  @@index([hostOrganizationId, name])
}

/// Contact rattaché à une organisation externe (plusieurs contacts ≠ plusieurs fournisseurs).
model ExternalOrgContact {
  id                     String   @id @default(cuid())
  externalOrganizationId String
  firstName              String
  lastName               String
  jobTitle               String?
  email                  String?
  phone                  String?
  /// Compte BeWork éventuel (accès collaboratif)
  userId                 String?
  isPrimary              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  externalOrganization ExternalOrganization @relation(fields: [externalOrganizationId], references: [id], onDelete: Cascade)
  user                 User?                @relation("ExternalOrgContactUser", fields: [userId], references: [id], onDelete: SetNull)
  purchaseOrders       PurchaseOrder[]      @relation("PurchaseOrderContact")

  @@index([externalOrganizationId])
  @@index([userId])
  @@index([email])
}

/// Statuts métier commande chantier (CDE-1).
enum PurchaseOrderStatus {
  BROUILLON
  A_VALIDER
  VALIDEE
  ENVOYEE_FOURNISSEUR
  A_CONFIRMER
  CONFIRMEE
  LIVRAISON_PROGRAMMEE
  PARTIELLEMENT_RECUE
  RECUE
  CLOTUREE
  ANNULEE
  REFUSEE
}

/// Commande chantier — objet métier (pas un PDF, pas une Task).
model PurchaseOrder {
  id                       String              @id @default(cuid())
  organizationId           String
  /// Référence unique dans le tenant — ex. BC-2026-0043
  number                   String
  status                   PurchaseOrderStatus @default(BROUILLON)
  subject                  String
  projectId                String?
  followUpSheetId          String?
  externalOrganizationId   String
  contactId                String?
  requestedById            String
  /// Qui réceptionne la livraison
  responsibleId            String?
  validatorId              String?
  /// Pont démo / legacy vers Task « Bon de commande »
  legacyTaskId             String?             @unique

  requestedDeliveryAt      DateTime?
  confirmedDeliveryAt      DateTime?
  /// Proposition fournisseur (≠ date demandée ; n’écrit pas confirmed tant qu’acceptée)
  proposedDeliveryAt       DateTime?
  proposedDeliveryComment  String?             @db.Text
  /// NONE | PENDING | ACCEPTED | REFUSED
  proposedDeliveryStatus   String              @default("NONE")
  /// Motif de refus commande fournisseur
  supplierRefuseReason     String?
  /// CHANTIER | AGENCE | AUTRE
  deliveryPlaceType        String              @default("CHANTIER")
  deliveryAddress          String?

  supplierRef              String?
  quoteRef                 String?
  quoteDate                DateTime?
  amountHt                 Decimal?            @db.Decimal(14, 2)
  tvaRate                  Decimal?            @db.Decimal(5, 2)
  discountHt               Decimal?            @db.Decimal(14, 2)
  deliveryFeesHt           Decimal?            @db.Decimal(14, 2)
  paymentTerms             String?
  deliveryInstructions     String?             @db.Text
  siteContactName          String?
  siteContactPhone         String?
  partialDeliveryAllowed   Boolean             @default(true)
  internalNotes            String?             @db.Text
  supplierNotes            String?             @db.Text
  /// NORMAL | IMPORTANT | URGENT
  urgency                  String?
  /// Visible par le compte fournisseur uniquement si true
  sharedWithSupplier       Boolean             @default(false)

  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  followUpSheet        FollowUpSheet?       @relation(fields: [followUpSheetId], references: [id], onDelete: SetNull)
  externalOrganization ExternalOrganization @relation(fields: [externalOrganizationId], references: [id], onDelete: Restrict)
  contact              ExternalOrgContact?  @relation("PurchaseOrderContact", fields: [contactId], references: [id], onDelete: SetNull)
  requestedBy          User                 @relation("PurchaseOrderRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  responsible          User?                @relation("PurchaseOrderResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  validator            User?                @relation("PurchaseOrderValidator", fields: [validatorId], references: [id], onDelete: SetNull)
  legacyTask           Task?                @relation("PurchaseOrderLegacyTask", fields: [legacyTaskId], references: [id], onDelete: SetNull)

  lines     PurchaseOrderLine[]
  events    PurchaseOrderEvent[]
  documents PurchaseOrderDocument[]
  receipts  PurchaseOrderReceipt[]
  agendaEvents AgendaEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([projectId])
  @@index([followUpSheetId])
  @@index([externalOrganizationId])
  @@index([requestedById])
  @@index([responsibleId])
}

model PurchaseOrderLine {
  id             String   @id @default(cuid())
  orderId        String
  designation    String
  quantity       Decimal  @db.Decimal(14, 3)
  unit           String   @default("U")
  unitPriceHt    Decimal? @db.Decimal(14, 2)
  tvaRate        Decimal? @db.Decimal(5, 2)
  /// CACHE UI uniquement — source de vérité = PurchaseOrderReceiptLine (non annulées).
  /// Recalculé par refreshLineCaches() après chaque réception. Ne jamais alerter dessus.
  receivedQty    Decimal  @default(0) @db.Decimal(14, 3)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order        PurchaseOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receiptLines PurchaseOrderReceiptLine[]
  materialRequirementLinks MaterialRequirementOrderLink[]

  @@index([orderId])
}

enum MaterialRequirementStatus {
  PROPOSED
  VALIDATED
  CANCELLED
}

enum MaterialRequirementSourceType {
  MANUAL
  QUOTE_LINE
  DOCUMENT
  DPGF
  AI_PROPOSAL
}

/// Besoin matériau chantier (MATERIAUX-V1B) — pas un stock, pas une ligne devis.
model MaterialRequirement {
  id               String                        @id @default(cuid())
  organizationId   String
  projectId        String
  label            String
  siteResourceId   String?
  quantityRequired Decimal                       @db.Decimal(14, 3)
  unit             String
  /// null = aucune marge ; jamais inventer 5 % / 10 %
  lossFactor       Decimal?                      @db.Decimal(5, 4)
  neededAt         DateTime?
  status           MaterialRequirementStatus     @default(VALIDATED)
  sourceType       MaterialRequirementSourceType @default(MANUAL)
  sourceId         String?
  sourceLabel      String?
  chantierFileId   String?
  validatedById    String?
  validatedAt      DateTime?
  createdById      String
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteResource SiteResource? @relation(fields: [siteResourceId], references: [id], onDelete: SetNull)
  chantierFile ChantierFile? @relation(fields: [chantierFileId], references: [id], onDelete: SetNull)
  validatedBy  User?        @relation("MaterialRequirementValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  createdBy    User         @relation("MaterialRequirementCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  orderLinks   MaterialRequirementOrderLink[]

  @@index([organizationId, projectId])
  @@index([organizationId, projectId, status])
  @@index([siteResourceId])
  @@index([chantierFileId])
}

/// Allocation besoin → ligne BC (N–N, multi-fournisseurs). quantityAllocated = unité du besoin.
model MaterialRequirementOrderLink {
  id                     String   @id @default(cuid())
  organizationId         String
  materialRequirementId  String
  purchaseOrderLineId    String
  quantityAllocated      Decimal  @db.Decimal(14, 3)
  createdAt              DateTime @default(now())

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  materialRequirement  MaterialRequirement @relation(fields: [materialRequirementId], references: [id], onDelete: Cascade)
  purchaseOrderLine    PurchaseOrderLine   @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  @@unique([materialRequirementId, purchaseOrderLineId])
  @@index([materialRequirementId])
  @@index([purchaseOrderLineId])
  @@index([organizationId])
}

/// Réception chantier (plusieurs réceptions possibles par commande).
model PurchaseOrderReceipt {
  id                     String   @id @default(cuid())
  organizationId         String
  purchaseOrderId        String
  receivedAt             DateTime @default(now())
  receivedById           String
  /// COMPLETE | PARTIAL | WITH_ISSUES | REFUSED | CANCELLED
  status                 String
  deliveryNoteNumber     String?
  commentShared          String?  @db.Text
  commentInternal        String?  @db.Text
  agendaEventId          String?
  cancelledAt            DateTime?
  cancelledById          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy    User                  @relation("PurchaseOrderReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Cascade)
  lines         PurchaseOrderReceiptLine[]
  documents     PurchaseOrderDocument[]

  @@index([organizationId, receivedAt])
  @@index([purchaseOrderId, receivedAt])
  @@index([receivedById])
}

model PurchaseOrderReceiptLine {
  id              String   @id @default(cuid())
  receiptId       String
  orderLineId     String
  receivedQty     Decimal  @db.Decimal(14, 3)
  damagedQty      Decimal  @default(0) @db.Decimal(14, 3)
  refusedQty      Decimal  @default(0) @db.Decimal(14, 3)
  /// ENDOMMAGE | MAUVAISE_REF | NON_CONFORME | AUTRE
  refuseReason    String?
  comment         String?
  createdAt       DateTime @default(now())

  receipt   PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine PurchaseOrderLine    @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([orderLineId])
}

model PurchaseOrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  kind        String
  label       String
  detail      String?  @db.Text
  actorUserId String?
  createdAt   DateTime @default(now())

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User?         @relation("PurchaseOrderEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model PurchaseOrderDocument {
  id        String   @id @default(cuid())
  orderId   String
  receiptId String?
  /// DEVIS | BC | CONFIRMATION | BL | FICHE_TECHNIQUE | FACTURE | AUTRE
  kind      String
  name      String
  fileUrl   String?
  createdAt DateTime @default(now())

  order   PurchaseOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receipt PurchaseOrderReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([receiptId])
}

/// Accès explicite d’un utilisateur à un chantier (périmètre).
model ProjectAccess {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  scopesJson  Json?    // { messages, documents, agenda, deliveries }
  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("ProjectAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?   @relation("ProjectAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

/// Journal des accès / modifications sensibles.
model AccessAuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  targetUserId   String?
  action         String
  detail         String?  @db.Text
  createdAt      DateTime @default(now())

  actor  User? @relation("AccessAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AccessAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([targetUserId, createdAt])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

/// Entreprise cliente (tenant) — le User CLIENT propriétaire reste pour facturation / legacy.
model Organization {
  id          String   @id @default(cuid())
  name        String
  siret       String?
  ownerUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User                 @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members          OrganizationMember[]
  projects         Project[]
  tasks            Task[]
  demoEnvironment  DemoEnvironment?
  externalOrganizations ExternalOrganization[]
  workflows             WorkflowDefinition[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderReceipts PurchaseOrderReceipt[]
  materialRequirements  MaterialRequirement[]
  materialRequirementOrderLinks MaterialRequirementOrderLink[]
  /// Domaine Devis & Facturation (Commercial*) — isolé des Quote* / Invoice / Payment SaaS
  commercialOrgSettings     CommercialOrgSettings?
  commercialQuotes          CommercialQuote[]
  commercialAmendments      CommercialAmendment[]
  commercialInvoices        CommercialInvoice[]
  commercialPayments        CommercialPayment[]
  commercialWorkItems       CommercialWorkItem[]
  commercialMaterials       CommercialMaterial[]
  commercialLaborResources  CommercialLaborResource[]
  commercialEquipmentResources CommercialEquipmentResource[]
  commercialStatusEvents    CommercialStatusEvent[]
  commercialQuoteSnapshots  CommercialQuoteSnapshot[]

  @@index([ownerUserId])
  @@unique([ownerUserId])
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole @default(MEMBER)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Formule / abonnement client (historique et état)
model Subscription {
  id         String   @id @default(cuid())
  userId     String
  planKey    String   // DECOUVERTE | STANDARD | STANDARD_PLUS | PREMIUM
  status     SubscriptionStatus @default(ACTIVE)
  startedAt DateTime @default(now())
  renewsAt  DateTime?  // prochain renouvellement (formules mensuelles)
  endedAt   DateTime?  // fin (résiliation ou one-shot)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  PENDING   // en attente de paiement
  ACTIVE    // actif
  EXPIRED   // expiré
  CANCELLED // résilié
}

// Paiement (historique)
model Payment {
  id               String        @id @default(cuid())
  userId           String
  subscriptionId   String?
  planKey          String
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("EUR")
  status           PaymentStatus @default(PENDING)
  actionsCredited  Int           @default(0)
  externalId       String?       // Stripe payment intent id, etc.
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Historique des mouvements d'actions (crédit / débit)
model ActionsTransaction {
  id           String              @id @default(cuid())
  userId       String
  type         ActionsTransactionType
  source       ActionsTransactionSource
  amount       Int                 // positif = crédit, négatif = débit
  description  String?
  referenceId  String?             // id Payment ou autre
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum ActionsTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

enum ActionsTransactionSource {
  SUBSCRIPTION   // crédit souscription
  ONE_TIME       // offre Découverte
  RENEWAL        // renouvellement mensuel
  ADMIN          // ajustement manuel
  TASK_DEDUCTION // débit tâche terminée
}

enum UserRole {
  CLIENT  // Client
  AGENCE  // Agent agence (opérationnel)
  MANAGER // Gérant de l'agence
  AGENT   // Assistante virtuelle (exécution des tâches)
}

enum ClientAccountStatus {
  PENDING_APPROVAL // Inscription en ligne — accès plateforme bloqué
  APPROVED         // Validé par BeWork — connexion autorisée
  REJECTED         // Inscription refusée
}

enum ContractStatus {
  PENDING  // En attente de signature
  SIGNED   // Contrat signé électroniquement
}

// Projets / chantiers (liés à un client) – dossier chantier numérique
model Project {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        ProjectStatus  @default(EN_COURS)
  clientId      String
  organizationId String?
  assignedToId  String?        // agent (User rôle AGENCE) en charge du projet
  dateSouhaitee DateTime?      // date souhaitée pour le début
  deadline      DateTime?      // deadline d'exécution
  urgency       ProjectUrgency @default(MOYENNE)
  notes         String?        // instructions ou détails administratifs
  // Champs dossier chantier BTP
  siteAddress       String?
  siteCity          String?
  internalManager   String?    // responsable interne entreprise
  signedQuoteAmount Decimal?   @db.Decimal(14, 2)
  plannedStartDate  DateTime?  @db.Date
  plannedEndDate    DateTime?  @db.Date
  chantierStatus    ChantierStatus @default(ETUDE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  client     User       @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedTo User?      @relation("AssignedProjects", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]
  documents  Document[]
  tasks      Task[]
  invoices   Invoice[]
  metrics    Metric[]
  activities Activity[]
  appointments Appointment[]
  agendaEvents AgendaEvent[]
  followUpSheets FollowUpSheet[]
  purchaseOrders PurchaseOrder[]
  materialRequirements MaterialRequirement[]
  reports Report[]
  skillPpspsSessions SkillPpspsSession[]
  chantierFolders ChantierFolder[]
  chantierFiles   ChantierFile[]
  worksitePilotages WorksitePilotage[]
  projectAccesses ProjectAccess[]
  projectChannels ProjectChannel[]
  commercialQuotes CommercialQuote[]
  commercialInvoices CommercialInvoice[]

  @@index([organizationId])
}

// Statut métier du chantier (pilotage conducteur de travaux)
enum ChantierStatus {
  ETUDE
  EN_COURS
  EN_ATTENTE
  RECEPTION
  TERMINE
}

// Rubrique du classeur chantier (01 Devis, 02 Contrats, …)
model ChantierFolder {
  id        String   @id @default(cuid())
  projectId String
  code      String   // ex. "01"
  label     String   // ex. "Devis & avenants"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files   ChantierFile[]

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
}

// Fichier ou pièce attendue dans une rubrique chantier (GED chantier)
model ChantierFile {
  id           String             @id @default(cuid())
  projectId    String
  folderId     String
  clientId     String
  name         String
  fileUrl      String?            // null si statut MANQUANT (pièce attendue)
  fileSize     Int?
  mimeType     String?
  documentType String?            // type libellé BTP (BL, assurance ST, CR n°12…)
  status       ChantierFileStatus @default(RECU)
  comment      String?
  addedById    String?
  taskId             String?   // mission BeWork liée (livrable / pièce de travail)
  sourceDocumentId   String?   @unique // copie classeur depuis pièce jointe mission (Document)
  // Préparation IA (classification, résumé, détection manquants) — non utilisé en V1
  aiSummary           String?   @db.Text
  aiClassifiedAt      DateTime?
  aiSuggestedFolderId String?
  /// GED universelle — classification & versionnage
  category             String?
  subcategory          String?
  tags                 String?
  versionLabel         String?   @default("1")
  indice               String?
  visibility           String    @default("Interne entreprise cliente")
  isCurrentVersion     Boolean   @default(true)
  replacesFileId       String?
  checksum             String?
  classificationStatus String    @default("CLASSE") // A_CLASSER | CLASSE
  storagePath          String?
  previewStatus        String?   // Aperçu disponible | Aperçu indisponible | Traitement | …
  documentDate         DateTime? @db.Date
  emitterName          String?
  financialMeta        Json?
  deletedAt            DateTime?
  archivedAt           DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder   ChantierFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  client   User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addedBy  User?          @relation("ChantierFileAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  task     Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  replacesFile ChantierFile?  @relation("ChantierFileVersions", fields: [replacesFileId], references: [id], onDelete: SetNull)
  replacedByFiles ChantierFile[] @relation("ChantierFileVersions")
  links    ChantierFileLink[]
  comments ChantierFileComment[]
  favorites ChantierFileFavorite[]
  marketDocuments PilotageMarketDocument[]
  materialRequirements MaterialRequirement[]

  @@index([projectId, folderId])
  @@index([clientId])
  @@index([status])
  @@index([taskId])
  @@index([classificationStatus])
  @@index([deletedAt])
  @@index([isCurrentVersion])
  @@index([checksum])
}

/// Lien document GED ↔ élément Pilotage / chantier
model ChantierFileLink {
  id          String   @id @default(cuid())
  fileId      String
  entityType  String
  entityId    String?
  entityLabel String?
  pilotageId  String?
  createdById String?
  createdAt   DateTime @default(now())

  file ChantierFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([entityType, entityId])
  @@index([pilotageId])
}

/// Commentaire / annotation (ne modifie jamais le fichier original)
model ChantierFileComment {
  id          String    @id @default(cuid())
  fileId      String
  authorId    String?
  authorName  String?
  content     String    @db.Text
  pageNumber  Int?
  visibility  String    @default("Interne BeWork")
  status      String    @default("Ouvert")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  file   ChantierFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author User?        @relation("ChantierFileCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([fileId, createdAt])
  @@index([status])
}

model ChantierFileFavorite {
  id        String   @id @default(cuid())
  fileId    String
  userId    String
  createdAt DateTime @default(now())

  file ChantierFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId])
  @@index([userId])
}

enum ChantierFileStatus {
  RECU
  A_VERIFIER
  VALIDE
  MANQUANT
  A_RELANCER
}

enum ProjectStatus {
  NOUVEAU
  EN_COURS
  EN_ATTENTE
  TERMINE
}

enum ProjectUrgency {
  BASSE
  MOYENNE
  HAUTE
  URGENTE
}

// Messages entre client et agence
model Message {
  id         String   @id @default(cuid())
  content    String
  projectId  String
  senderId   String
  receiverId String
  read       Boolean  @default(false)
  /// Fil chantier V2 (legacy) : INTERNE | CLIENT | FOURNISSEUR | SOUS_TRAITANT
  channel    String   @default("CLIENT")
  /// Canal chantier V2C.6 — périmètre de confidentialité (nullable = legacy à backfiller)
  channelId  String?
  /// Pièces jointes messagerie V2C : [{ name, fileUrl, fileSize, mimeType, kind?, durationSec? }]
  attachmentsJson Json?
  /// Soft-delete « pour tous » (V2C.4.1) — contenu masqué, record conservé
  deletedAt   DateTime?
  deletedById String?
  createdAt  DateTime @default(now())

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectChannel  ProjectChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  sender          User            @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User            @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  channelReceipts MessageChannelReceipt[]

  @@index([projectId, channel, createdAt])
  @@index([channelId, createdAt])
  @@index([receiverId, read])
  @@index([deletedAt])
}

/// Accusé de lecture par participant de canal (V2C.6) — unread par user × message.
model MessageChannelReceipt {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageChannelReceipts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, read])
  @@index([messageId])
}

/// Canal de messagerie chantier — périmètre de confidentialité (V2C.6).
/// Un chantier = conteneur ; un canal = qui peut lire.
model ProjectChannel {
  id                     String   @id @default(cuid())
  projectId              String
  /// INTERNAL | CLIENT | SUPPLIER | SUBCONTRACTOR | PARTNER | MOE | CONTROL_OFFICE
  type                   String
  /// Null pour INTERNAL ; obligatoire pour canaux externes (isolation org).
  externalOrganizationId String?
  /// Clé anti-doublon : `{projectId}:{type}:{externalOrganizationId|internal}`
  dedupeKey              String   @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalOrganization ExternalOrganization? @relation(fields: [externalOrganizationId], references: [id], onDelete: SetNull)
  participants         ProjectChannelParticipant[]
  messages             Message[]

  @@index([projectId, type])
  @@index([externalOrganizationId])
}

/// Membre explicite d’un canal chantier (V2C.6).
/// Retrait = plus d’accès lecture/écriture/unread/realtime (politique stricte).
model ProjectChannelParticipant {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  addedById String?
  createdAt DateTime @default(now())

  channel ProjectChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User           @relation("ProjectChannelParticipants", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?          @relation("ProjectChannelParticipantAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
}

// Documents déposés par les clients (optionnellement liés à un projet ou une tâche)
model Document {
  id        String   @id @default(cuid())
  name      String
  category  DocumentCategory @default(AUTRE)
  fileUrl   String
  fileSize  Int      // en octets
  mimeType  String?
  status    DocumentStatus @default(EN_ATTENTE)
  clientId  String
  projectId String?
  taskId    String?  // pièce jointe d'une tâche
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

enum DocumentCategory {
  FACTURE
  CONTRAT
  RH
  FISCAL
  AUTRE
}

enum DocumentStatus {
  EN_ATTENTE
  EN_TRAITEMENT
  TRAITE
  ARCHIVE
}

// Tâches administratives (optionnellement liées à un projet)
model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(NOUVEAU)
  clientId       String
  organizationId String?
  projectId      String?   // projet auquel la tâche se rapporte (optionnel)
  category         String?   // Gestion d'emails, Recherche, Organisation, etc.
  missionType      String?   // DEVIS_CHIFFRAGE, COMPTE_RENDU_CHANTIER, etc.
  priority         String?   // STANDARD | PRIORITAIRE | URGENT
  desiredDate      DateTime? @db.Date  // date souhaitée par le client
  estimatedActions Int?      // crédits / actions estimés
  assignedToId   String?   // agent assigné
  createdById    String?   // gérant créateur (mission interne)
  agencyNotes    String?   // notes internes gérante / agent
  clientVisibleNotes String? // notes visibles par le client
  correctionNote String?   // note quand le responsable demande une correction
  validatedAt    DateTime? // date de validation du travail par l'agence
  completedAt    DateTime?
  timeSpentMinutes Int?    // temps réel passé (minutes) — renseigné par l'agent
  actionsUsed      Int?    // actions déduites (ceil(min/10), min 1)
  creditsDeductedAt DateTime? // date de débit effectif sur le compteur client
  clientReport     String?   // compte rendu envoyé au client
  clientReportSentAt DateTime?
  clientReportSentById String?
  clientDeliveryJson   Json?     // pièces visibles client, options transmission
  /// Décision client après transmission : EN_ATTENTE_CLIENT | ACCEPTE | REFUSE | RESERVES
  clientDecision       String?
  clientDecisionAt     DateTime?
  clientDecisionNote   String?   @db.Text
  // Mémoire des missions (contacts et fournisseurs pour relance)
  contactsJson    Json?    // [{ name, email, role }]
  suppliersJson   Json?    // [{ name, contact }]
  /// Provenance messagerie : TASK | DIRECT | PROJECT
  sourceMessageKind String?
  sourceMessageId   String?
  /// Affaire / fiche de suivi (OS) — lien métier Task ↔ FollowUpSheet
  followUpSheetId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client     User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo User?        @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation("TasksCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  followUpSheet FollowUpSheet? @relation(fields: [followUpSheetId], references: [id], onDelete: SetNull)
  comments   TaskComment[]
  documents  Document[]
  taskMessages TaskMessage[]
  chantierFiles ChantierFile[]
  agendaEvents AgendaEvent[]
  purchaseOrderAsLegacy PurchaseOrder? @relation("PurchaseOrderLegacyTask")

  @@index([organizationId])
  @@index([sourceMessageKind, sourceMessageId])
  @@index([followUpSheetId])
}

enum TaskStatus {
  NOUVEAU         // Nouvelle demande (client vient de créer)
  EN_ATTENTE      // En attente (avant assignation ou en attente d'info)
  ASSIGNEE        // Agent assigné par la gérante
  EN_ANALYSE      // Agent analyse la demande
  EN_COURS        // En cours de traitement
  EN_ATTENTE_INFO // En attente d'information (client ou autre)
  A_VALIDER       // Travail terminé, en attente de validation gérante
  COMPLETE        // Terminée (validée par la gérante)
}

// Messages directs entre gérants et agents (sans mission)
model DirectMessage {
  id             String   @id @default(cuid())
  senderId       String
  receiverId     String
  content        String
  attachmentsJson Json?   // [{ name, fileUrl, fileSize, mimeType }]
  read           Boolean  @default(false)
  kind           String   @default("USER") // USER | SYSTEM
  payloadJson    Json?
  /// Soft-delete « pour tous » (V2C.4.1)
  deletedAt   DateTime?
  deletedById String?
  createdAt      DateTime @default(now())

  sender   User @relation("DirectMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("DirectMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, read])
  @@index([receiverId, createdAt])
  @@index([deletedAt])
}

// Messages sur une tâche (client ↔ agent quand assigné, ou interne gérante ↔ agent)
model TaskMessage {
  id         String   @id @default(cuid())
  taskId     String
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  isInternal Boolean  @default(false)  // true = visible uniquement gérante/agent
  kind       String   @default("USER") // USER | SYSTEM
  payloadJson Json?
  attachmentsJson Json? // [{ name, fileUrl, fileSize, mimeType }]
  /// Soft-delete « pour tous » (V2C.4.1)
  deletedAt   DateTime?
  deletedById String?
  createdAt  DateTime @default(now())

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender  User @relation("TaskMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("TaskMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([receiverId])
  @@index([receiverId, read])
  @@index([deletedAt])
}

/// Masquage personnel « Supprimer pour moi » — persistant, multi-backends (V2C.4.1)
model MessageUserHide {
  id          String   @id @default(cuid())
  userId      String
  messageKind String   // DIRECT | TASK | PROJECT
  messageId   String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageKind, messageId])
  @@index([userId, messageKind])
  @@index([messageKind, messageId])
}

// Commentaires sur tâches (optionnellement internes = invisibles client)
model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Notifications pour tous les rôles (client, agent, gérante)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // NEW_TASK, TASK_ASSIGNED, MESSAGE_RECEIVED, TASK_COMPLETED, TASK_TO_VALIDATE, FOLLOWUP_*, etc.
  title     String
  message   String
  read      Boolean  @default(false)
  actionUrl String?
  /// Clé stable de déduplication (ex. ATTENTION:userId:sheetId:CODE:LEVEL). Null = notif classique.
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([userId, read, createdAt])
}

// Factures
model Invoice {
  id            String        @id @default(cuid())
  projectId     String
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime
  paidDate      DateTime?
  createdAt     DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

// Métriques / KPIs (pour rapports et simulation)
model Metric {
  id         String   @id @default(cuid())
  projectId  String
  metricDate DateTime
  metricType String   // social_media, support_emails, response_time, etc.
  metricData Json     // données flexibles
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Timeline activité récente
model Activity {
  id        String   @id @default(cuid())
  type      String   // DOCUMENT_UPLOADED, TASK_COMPLETED, MESSAGE_SENT, etc.
  title     String
  detail    String?
  clientId  String
  projectId String?  // optionnel : lier à un projet
  metadata  Json?    // données supplémentaires
  createdAt DateTime @default(now())

  client  User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// Alertes importantes (optionnellement avec lien d'action)
model Alert {
  id        String   @id @default(cuid())
  title     String
  message   String
  level     AlertLevel @default(INFO)
  clientId  String
  actionUrl String?   // lien direct (ex. vers le projet pour un nouveau message)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum AlertLevel {
  INFO
  WARNING
  URGENT
}

// Demandes de contact / RDV depuis le formulaire public
model ContactRequest {
  id                  String            @id @default(cuid())
  structure           String
  denominationSociale String?
  contactName         String
  email               String
  phone               String?
  formule             String?
  message             String?
  rdvDate             DateTime?         @db.Date
  rdvTime             String?           // "09:00", "09:30", ...
  sector              String?
  howKnown            String?
  marketType          String?
  tradeActivity       String?
  mainNeed            String?
  consent             Boolean           @default(false)
  source              String?           @default("homepage_contact_form")
  status              ContactRequestStatus @default(NOUVEAU)
  createdAt           DateTime          @default(now())

  @@index([rdvDate, rdvTime])
  @@index([status])
}

enum ContactRequestStatus {
  NOUVEAU
  CONFIRME
  ANNULE
}

// Rendez-vous (calendrier type Calendly)
model Appointment {
  id           String   @id @default(cuid())
  title        String
  startAt      DateTime
  endAt        DateTime
  organizerId  String   // User agence/gérant qui organise
  clientId     String?  // User client (si connecté)
  clientEmail  String?  // Email si prise de RDV externe
  clientName   String?
  projectId    String?
  notes        String?  @db.Text
  comments     Json?    // [{ userId, text, createdAt }]
  recurrence   String?  // "NONE" | "WEEKLY" | "BIWEEKLY" | "MONTHLY"
  recurrenceEndAt DateTime?
  reminderSentAt  DateTime?
  status       AppointmentStatus @default(CONFIRME)
  contactRequestId String?  @unique  // Si issu d'une demande de contact
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizer    User     @relation("AppointmentOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  client       User?    @relation("AppointmentClient", fields: [clientId], references: [id], onDelete: SetNull)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  attachments  AppointmentAttachment[]
}

enum AppointmentStatus {
  CONFIRME
  ANNULE
  TERMINE
}

// Agenda entreprise BTP (distinct des RDV Calendly / Appointment)
enum AgendaEventType {
  REUNION_CHANTIER
  VISITE_CHANTIER
  RDV_CLIENT
  RDV_FOURNISSEUR
  LIVRAISON
  INTERVENTION
  ECHEANCE
  ADMINISTRATIF
  COMMANDE
  FACTURATION
  SITUATION
  RECEPTION
  LEVEE_RESERVES
  CONTROLE
  FORMATION
  CONGE
  INTERNE
  AUTRE
}

enum AgendaEventStatus {
  PLANIFIE
  CONFIRME
  TERMINE
  ANNULE
}

enum AgendaAttendeeStatus {
  INVITE
  ACCEPTE
  REFUSE
  EN_ATTENTE
}

model AgendaEvent {
  id              String            @id @default(cuid())
  organizationId  String?
  ownerUserId     String
  createdById     String
  title           String
  description     String?           @db.Text
  location        String?
  type            AgendaEventType   @default(AUTRE)
  status          AgendaEventStatus @default(PLANIFIE)
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean           @default(false)
  projectId       String?
  appointmentId   String?           @unique
  followUpSheetId String?
  /// Commande / mission liée (ex. BC → livraison unique)
  taskId          String?
  /// Commande chantier CDE-1
  purchaseOrderId String?
  responsibleId   String?
  reminderMinutes Int?
  recurrence      String?           // NONE | DAILY | WEEKLY | MONTHLY | YEARLY | CUSTOM
  recurrenceRule  String?
  colorKey        String?
  externalUid     String?           // sync future Google / Outlook / ICS
  /// Provenance messagerie : TASK | DIRECT | PROJECT
  sourceMessageKind String?
  sourceMessageId   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  owner       User                 @relation("AgendaEventOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("AgendaEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  responsible User?                @relation("AgendaEventResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  followUpSheet FollowUpSheet?     @relation(fields: [followUpSheetId], references: [id], onDelete: SetNull)
  task        Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  attendees   AgendaEventAttendee[]

  @@index([ownerUserId, startAt])
  @@index([organizationId, startAt])
  @@index([projectId, startAt])
  @@index([followUpSheetId, startAt])
  @@index([taskId, startAt])
  @@index([purchaseOrderId, startAt])
  @@index([type, startAt])
  @@index([sourceMessageKind, sourceMessageId])
}

model AgendaEventAttendee {
  id        String               @id @default(cuid())
  eventId   String
  userId    String
  status    AgendaAttendeeStatus @default(EN_ATTENTE)
  createdAt DateTime             @default(now())

  event AgendaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// Fiche de suivi (remplace post-it bureau : 1 OS / 1 commande = 1 fiche)
enum FollowUpSheetStatus {
  NOUVEAU
  A_ANALYSER
  A_PLANIFIER
  PLANIFIE
  COMMANDE_FOURNISSEUR
  COMMANDE_PASSEE
  ATTENTE_FOURNISSEUR
  INTERVENTION_PREVUE
  EN_COURS
  TRAVAUX_TERMINES
  CR_A_RECUPERER
  AVENANT
  A_FACTURER
  FACTURE
  ATTENTE_REGLEMENT
  TERMINE
  ARCHIVE
}

enum FollowUpUrgency {
  NORMAL
  A_SURVEILLER
  IMPORTANT
  URGENT
  CRITIQUE
}

model FollowUpSheet {
  id                String             @id @default(cuid())
  organizationId    String?
  ownerUserId       String
  createdById       String
  assigneeId        String?
  projectId         String?
  reference         String?
  clientName        String?
  marketLabel       String?
  siteAddress       String?
  title             String
  workObject        String?
  orderNumber       String?
  osNumber          String?
  receivedAt        DateTime?
  amountHt          Decimal?           @db.Decimal(14, 2)
  status            FollowUpSheetStatus @default(NOUVEAU)
  colorKey          String             @default("bleu")
  nextAction        String?
  nextActionAt      DateTime?
  nextActionDone    Boolean            @default(false)
  urgencyOverride   FollowUpUrgency?
  notes             String?            @db.Text
  reminderOffsets   Json?
  postponedFromAt   DateTime?
  postponeCount     Int                @default(0)
  /// Processus métier org (optionnel — sinon workflow par défaut)
  workflowId        String?
  /// Provenance messagerie : TASK | DIRECT | PROJECT
  sourceMessageKind String?
  sourceMessageId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  owner     User   @relation("FollowUpSheetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy User   @relation("FollowUpSheetCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User?  @relation("FollowUpSheetAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workflow  WorkflowDefinition? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  timeline  FollowUpTimelineEvent[]
  agendaEvents AgendaEvent[]
  tasks     Task[]
  purchaseOrders PurchaseOrder[]

  @@index([ownerUserId, status])
  @@index([assigneeId, nextActionAt])
  @@index([projectId])
  @@index([organizationId, status])
  @@index([workflowId])
  @@index([nextActionAt])
  @@index([sourceMessageKind, sourceMessageId])
}

model FollowUpTimelineEvent {
  id          String   @id @default(cuid())
  sheetId     String
  authorId    String?
  kind        String
  label       String
  detail      String?  @db.Text
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  sheet  FollowUpSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  author User?         @relation("FollowUpTimelineAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sheetId, occurredAt])
}

/// Action légère issue d'un message (rappel / assignation) — sans dupliquer Agenda/Task/Fiche.
model MessageAction {
  id                String    @id @default(cuid())
  sourceMessageKind String    // TASK | DIRECT | PROJECT
  sourceMessageId   String
  type              String    // REMINDER | ASSIGN | LINK
  status            String    @default("OPEN") // OPEN | DONE | CANCELLED
  title             String
  assigneeId        String?
  dueAt             DateTime?
  priority          String?   // STANDARD | IMPORTANT | URGENT
  createdById       String
  agendaEventId     String?
  taskId            String?
  followUpSheetId   String?
  metaJson          Json?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  completedById     String?

  assignee    User? @relation("MessageActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User  @relation("MessageActionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  completedBy User? @relation("MessageActionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([createdById, status])
  @@index([sourceMessageKind, sourceMessageId])
  @@index([status, dueAt])
}

// Seuils d'urgence + regles metier (alertes / rappels) — 1 config par compte proprietaire.
model FollowUpAlertSettings {
  id              String   @id @default(cuid())
  ownerUserId     String   @unique
  thresholdsJson  Json?
  rulesJson       Json?
  escalateJson    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner User @relation("FollowUpAlertSettingsOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
}


/// Processus métier configurable — étapes = FollowUpSheetStatus (pas de 2e moteur).
model WorkflowDefinition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?  @db.Text
  /// CHANTIER_STANDARD | MAINTENANCE | TRAVAUX_AVENANT | CUSTOM
  templateKey    String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  sheets       FollowUpSheet[]

  @@index([organizationId, isDefault])
  @@index([organizationId, templateKey])
}

/// Étape d’un processus — statusKey = valeur FollowUpSheetStatus.
model WorkflowStep {
  id                   String   @id @default(cuid())
  workflowId           String
  statusKey            String
  label                String
  description          String?  @db.Text
  colorKey             String   @default("jaune")
  sortOrder            Int      @default(0)
  visibleOnBoard       Boolean  @default(true)
  /// DIRECTION | ADMINISTRATIF | CONDUCTEUR | ACHATS | COMPTABILITE
  defaultRole          String?
  defaultAssigneeId    String?
  delayHours           Int?
  reminderHours        Int?
  alertOrangeHours     Int?
  alertRedHours        Int?
  escalateHours        Int?
  nextActionLabel      String?
  nextActionDelayHours Int?
  initialUrgency       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, statusKey])
  @@index([workflowId, sortOrder])
}

// Pièces jointes sur un rendez-vous
model AppointmentAttachment {
  id            String @id @default(cuid())
  appointmentId String
  name          String
  fileUrl       String
  fileSize      Int
  mimeType      String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// Reporting hebdomadaire ou journalier entre client et agent
model Report {
  id          String      @id @default(cuid())
  projectId   String
  authorId    String
  reportType  ReportType  @default(HEBDOMADAIRE)
  periodStart DateTime    @db.Date  // début de la période couverte
  periodEnd   DateTime    @db.Date  // fin de la période couverte
  content     String      @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User        @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments ReportAttachment[]
  comments    ReportComment[]
}

enum ReportType {
  JOURNALIER
  HEBDOMADAIRE
}

// Pièces jointes sur un rapport
model ReportAttachment {
  id        String   @id @default(cuid())
  reportId  String
  name      String
  fileUrl   String
  fileSize  Int
  mimeType  String?
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// Commentaires sur un rapport
model ReportComment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── BeWork Devis — bibliothèque interne (référentiel ouvrages / prix / sources) ───

enum WorkItemQualityLevel {
  standard
  confort
  premium
}

enum WorkItemStatus {
  brouillon
  a_completer
  a_verifier
  valide
  archive
}

enum WorkItemItemType {
  ouvrage_technique
  etude_controle
  prestation_administrative
  garantie_assurance
  frais_annexe
}

/// Statut de regroupement doublons (aucune suppression — fusion réversible)
enum WorkItemMergeStatus {
  unique
  canonical
  merged
}

enum WorkItemMergeProposalStatus {
  pending
  approved
  rejected
}

enum BeWorkPriceDocSourceType {
  devis
  bpu
  dpgf
  marche_public
  estimation_interne
  autre
}

/// Statut de la codification BeWork BW-[LOT]-[FAM]-[OUV]-[NNN]
enum WorkItemCodificationStatus {
  pending
  auto
  a_verifier
  valide
}

enum WorkItemCodificationMappingMatchType {
  exact
  prefix
  regex
  artiprix_chapter
}

enum WorkItemCatalogStatus {
  active
  archived
}

/// Bibliothèque d’ouvrages (référentiels séparés : historique, Artiprix, DCE…)
model WorkItemCatalog {
  id           String                @id @default(cuid())
  slug         String                @unique
  name         String
  description  String?               @db.Text
  status       WorkItemCatalogStatus @default(active)
  isDefault    Boolean               @default(false)
  sourceLabel  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  workItems         WorkItem[]
  dceFillSessions   DcePricingFillSession[]

  @@index([status])
  @@index([isDefault])
}

enum DcePricingFillStatus {
  draft
  extracting
  extracted
  matching
  ready
  failed
}

enum DcePricingTargetDocType {
  dpgf
  bpu
}

/// Session d’extraction DCE → lignes BPU/DPGF + rapprochement bibliothèque
model DcePricingFillSession {
  id            String                  @id @default(cuid())
  catalogId     String
  catalog       WorkItemCatalog         @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  title         String
  targetDocType DcePricingTargetDocType @default(dpgf)
  dceFileName   String?
  extractedText String?                 @db.Text
  lines         Json?
  matchReport   Json?
  status        DcePricingFillStatus    @default(draft)
  errorMessage  String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([catalogId])
  @@index([status])
  @@index([createdAt])

  dpgfAnalysisSheets DpgfAnalysisSheet[]
}

enum DpgfAnalysisSheetSource {
  dpgf
  bpu
  cctp
  manuel
  import
}

enum DpgfAnalysisComprehensionLevel {
  debutant
  intermediaire
  confirme
}

/// Fiche pédagogique d’analyse DPGF — compréhension ligne par ligne (sans prix)
model DpgfAnalysisSheet {
  id                    String                         @id @default(cuid())
  codeSheet             String                         @unique
  lot                   String
  /// Corps de métier BeWork (ex. CLO, CAR)
  tradeCode             String?
  /// Famille d’ouvrage (libellé)
  familyName            String?
  /// Type d’ouvrage (libellé court)
  ouvrageType           String?
  originalDesignation   String                         @db.Text
  simplifiedDesignation String?
  unit                  String
  source                DpgfAnalysisSheetSource        @default(manuel)
  status                WorkItemStatus                 @default(brouillon)
  comprehensionLevel    DpgfAnalysisComprehensionLevel @default(intermediaire)
  /// Intervenant réel ou probable (saisie manuelle — jamais déduit du lot seul)
  intervenantConcerne   String?                        @db.Text
  /// Prix HT saisi manuellement par l'utilisateur (optionnel, jamais calculé automatiquement)
  manualPriceHt         Decimal?                       @db.Decimal(14, 4)
  hasModeOperatoire     Boolean                        @default(false)
  hasVigilancePoints    Boolean                        @default(false)
  hasQuestions          Boolean                        @default(false)
  /// Contenu pédagogique structuré (traduction, vigilance, mode opératoire…)
  content               Json
  /// Liens marché : session DCE, ligne, CCTP, plans…
  links                 Json?
  dceFillSessionId      String?
  dceFillSession        DcePricingFillSession?         @relation(fields: [dceFillSessionId], references: [id], onDelete: SetNull)
  dceLineIndex          Int?
  workItemId            String?
  workItem              WorkItem?                      @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  quoteDocumentId       String?
  quoteDocument         QuoteDocument?                 @relation(fields: [quoteDocumentId], references: [id], onDelete: SetNull)
  createdByUserId       String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([lot])
  @@index([tradeCode])
  @@index([status])
  @@index([comprehensionLevel])
  @@index([source])
  @@index([hasModeOperatoire])
  @@index([hasVigilancePoints])
  @@index([hasQuestions])
  @@index([updatedAt])
  @@index([dceFillSessionId])
  @@index([workItemId])
}

/// Ouvrage BTP de la bibliothèque interne
model WorkItem {
  id                   String               @id @default(cuid())
  catalogId            String
  catalog              WorkItemCatalog      @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  code                 String
  lot                  String
  subLot               String?
  family               String?
  title                String
  shortDescription     String?              @db.Text
  fullDescription      String               @db.Text
  unit                 String
  qualityLevel         WorkItemQualityLevel @default(standard)
  technicalReference   String?
  includedItems        String?              @db.Text
  excludedItems        String?              @db.Text
  vigilancePoints      String?              @db.Text
  clientQuestions      String?              @db.Text
  companyQuestions     String?              @db.Text
  internalNotes        String?              @db.Text
  status               WorkItemStatus       @default(brouillon)
  itemType             WorkItemItemType     @default(ouvrage_technique)
  /// Code ou libellé court de famille BeWork (ex. TER, CAR) — lexique interne
  familyCode           String?
  /// Ancien code métier / import (ex. BW-MARTIN-15-1)
  sourceCode           String?
  /// Référence de ligne dans la source (ex. 15.1)
  sourceLine           String?
  /// Code canonique BeWork : BW-[LOT]-[FAMILLE]-[OUVRAGE]-[VARIANTE]
  codeBework           String?
  /// Libellé source d’import (Artiprix, Martin, VRD…)
  importSource         String?
  /// Code lot métier (GO, SO, VRD…)
  lotCode              String?
  /// Libellé famille technique (ex. Démolition / Dépose)
  familleNom           String?
  /// Code sous-famille (regroupement fin)
  sousFamilleCode      String?
  sousFamilleNom       String?
  /// Type d’ouvrage (CLO, PLA, FOU…)
  ouvrageCode          String?
  /// Désignation d’origine (import)
  designationSource    String?              @db.Text
  /// Statut codification (auto / à vérifier / validé)
  codificationStatus   WorkItemCodificationStatus @default(pending)
  /// Instantané JSON pour annulation recodification
  codificationSnapshot Json?
  codificationAppliedAt DateTime?
  /// Clé normalisée pour détection doublons (désignation)
  normalizedDesignation String?
  /// Fiche principale si cette ligne est une variante fusionnée
  canonicalWorkItemId  String?
  canonicalWorkItem    WorkItem?            @relation("WorkItemDuplicateGroup", fields: [canonicalWorkItemId], references: [id], onDelete: SetNull)
  mergedVariants       WorkItem[]           @relation("WorkItemDuplicateGroup")
  mergeStatus          WorkItemMergeStatus  @default(unique)
  mergedAt             DateTime?
  mergeNote            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  priceEntries              PriceEntry[]
  siteResourcePriceObservations SiteResourcePriceObservation[]
  quoteLines                QuoteLine[]
  siteResourceLinks         WorkItemSiteResource[]
  siteResourceAliases       SiteResourceAlias[]
  siteResourceGroupingProposals SiteResourceGroupingProposal[]
  mergeProposalsAsCanonical WorkItemMergeProposal[] @relation("MergeProposalCanonical")
  mergeProposalMembers      WorkItemMergeProposalMember[]
  classificationProposals   WorkItemClassificationProposal[]
  codificationRevertEntries WorkItemCodificationRevert[]
  dpgfAnalysisSheets        DpgfAnalysisSheet[]

  @@index([lot])
  @@index([status])
  @@index([unit])
  @@index([itemType])
  @@index([familyCode])
  @@index([normalizedDesignation])
  @@index([canonicalWorkItemId])
  @@index([mergeStatus])
  @@index([codeBework])
  @@index([lotCode])
  @@index([sousFamilleCode])
  @@index([ouvrageCode])
  @@index([codificationStatus])
  @@index([importSource])
  @@index([catalogId])
  @@unique([catalogId, code])
  @@unique([catalogId, codeBework])
}

/// Correspondance ancien code → structure BeWork (Artiprix, VRD-E09, préfixes…)
model WorkItemCodificationMapping {
  id               String                              @id @default(cuid())
  sourcePattern    String
  matchType        WorkItemCodificationMappingMatchType @default(exact)
  lotCode          String
  familleCode      String
  ouvrageCode      String
  sousFamilleCode  String?
  sousFamilleNom   String?
  importSourceHint String?
  priority         Int                                 @default(0)
  note             String?                             @db.Text
  active           Boolean                             @default(true)
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt

  @@index([active])
  @@index([matchType])
  @@index([priority])
  @@index([lotCode, familleCode, ouvrageCode])
}

/// Historique réversible d’une recodification appliquée
model WorkItemCodificationRevert {
  id            String   @id @default(cuid())
  workItemId    String
  workItem      WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  jobId         String?
  snapshot      Json
  appliedAt     DateTime @default(now())
  revertedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([workItemId])
  @@index([jobId])
  @@index([appliedAt])
}

/// Proposition de fusion de doublons ouvrages (validation humaine)
model WorkItemMergeProposal {
  id                    String                      @id @default(cuid())
  status                WorkItemMergeProposalStatus   @default(pending)
  proposedCanonicalId   String?
  proposedCanonical     WorkItem?                   @relation("MergeProposalCanonical", fields: [proposedCanonicalId], references: [id], onDelete: SetNull)
  canonicalDesignation  String
  normalizedKey         String
  similarityScore       Int
  matchReasons          Json?
  mergeMode             String                      @default("manual_review")
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  members               WorkItemMergeProposalMember[]

  @@index([status])
  @@index([normalizedKey])
  @@index([similarityScore])
}

/// Lien proposition ↔ ouvrage candidat (données conservées)
model WorkItemMergeProposalMember {
  id           String                @id @default(cuid())
  proposalId   String
  proposal     WorkItemMergeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  workItemId   String
  workItem     WorkItem              @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  isCanonical  Boolean               @default(false)
  designation  String
  similarityScore Int?

  @@unique([proposalId, workItemId])
  @@index([workItemId])
}

enum LibraryCleanupJobType {
  classification_preview
  classification_apply
  duplicate_detection
  duplicate_merge
  recodification_preview
  recodification_apply
  workitem_codification_preview
  workitem_codification_apply
  normalize_designations
}

enum LibraryCleanupJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum WorkItemClassificationConfidence {
  haute
  moyenne
  faible
}

enum WorkItemClassificationProposalStatus {
  pending
  approved
  rejected
  ignored
}

/// Journal des opérations de nettoyage bibliothèque (batch, dry-run, reprise)
model LibraryCleanupJob {
  id               String                  @id @default(cuid())
  jobType          LibraryCleanupJobType
  status           LibraryCleanupJobStatus @default(pending)
  dryRun           Boolean                 @default(true)
  batchSize        Int                     @default(50)
  processedCount   Int                     @default(0)
  successCount     Int                     @default(0)
  errorCount       Int                     @default(0)
  lastProcessedId  String?
  cursorMeta       Json?
  logs             Json?
  errorMessage     String?                 @db.Text
  startedAt        DateTime?
  finishedAt       DateTime?
  createdByUserId  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  classificationProposals WorkItemClassificationProposal[]

  @@index([jobType])
  @@index([status])
  @@index([createdAt])
}

/// Proposition de reclassement famille/lot (validation humaine)
model WorkItemClassificationProposal {
  id                  String                               @id @default(cuid())
  workItemId          String
  workItem            WorkItem                             @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  jobId               String?
  job                 LibraryCleanupJob?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  currentFamilyCode   String?
  currentLot          String?
  proposedFamilyCode  String
  proposedLot         String?
  proposedFamily      String?
  confidence          WorkItemClassificationConfidence
  matchReason         String                               @db.Text
  status              WorkItemClassificationProposalStatus @default(pending)
  reviewedAt          DateTime?
  reviewNote          String?                              @db.Text
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  @@index([workItemId])
  @@index([jobId])
  @@index([status])
  @@index([confidence])
  @@index([proposedFamilyCode])
}

// ─── BeWork Devis — ressources chantier (matériaux, consommables, locations…) ───

enum SiteResourceType {
  materiaux
  consommables
  location_engin
  location_outillage
  equipements
  services
}

enum SiteResourceStatus {
  brouillon
  a_verifier
  valide
  archive
  fusionne
}

enum SiteResourceConfidence {
  faible
  moyen
  eleve
}

enum SiteResourceAliasKind {
  synonyme
  extraction_ouvrage
  fournisseur
  orthographe
  ancien_libelle
  court
  variante_libelle
}

enum SiteResourceLinkRole {
  materiau_principal
  fourniture
  consommable
  location
  equipement
  service
  autre
}

enum SiteResourceExtractedFrom {
  title
  includedItems
  fullDescription
  manuel
}

enum SiteResourceGroupingProposalType {
  merge_as_alias
  create_variant
  new_resource
  keep_separate
  ignore
}

enum SiteResourceGroupingProposalStatus {
  pending
  approved
  rejected
}

enum SiteResourceExtractionRunStatus {
  draft
  preview
  applied
  cancelled
}

/// Fiche ressource chantier principale (regroupement intelligent, sans perte d’alias)
model SiteResource {
  id                      String                   @id @default(cuid())
  shortName               String
  fullDescription         String                   @db.Text
  resourceType            SiteResourceType
  family                  String
  subFamily               String?
  orderUnit               String
  siteUsage               String?                  @db.Text
  mainCharacteristics     String?                  @db.Text
  characteristicsToVerify String?                  @db.Text
  businessNotes           String?                  @db.Text
  confidenceLevel         SiteResourceConfidence   @default(moyen)
  status                  SiteResourceStatus       @default(brouillon)
  normalizedDesignation   String?
  mergedIntoId            String?
  mergedInto              SiteResource?            @relation("SiteResourceMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom              SiteResource[]           @relation("SiteResourceMerge")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  aliases            SiteResourceAlias[]
  variants           SiteResourceVariant[]
  priceObservations  SiteResourcePriceObservation[]
  workItemLinks      WorkItemSiteResource[]
  groupingProposals SiteResourceGroupingProposal[] @relation("ProposalTargetResource")
  groupingProposalsAsSource SiteResourceGroupingProposal[] @relation("ProposalCreatedResource")
  materialRequirements MaterialRequirement[]

  @@index([resourceType, family, subFamily])
  @@index([status])
  @@index([shortName])
  @@index([normalizedDesignation])
  @@index([mergedIntoId])
}

/// Prix observés rattachés à une fiche ressource (conservés lors des fusions)
model SiteResourcePriceObservation {
  id               String       @id @default(cuid())
  siteResourceId   String
  siteResource     SiteResource @relation(fields: [siteResourceId], references: [id], onDelete: Cascade)
  amountHT         Decimal      @db.Decimal(12, 4)
  orderUnit        String       @default("u")
  sourceName       String?
  sourceWorkItemId String?
  sourceWorkItem   WorkItem?    @relation(fields: [sourceWorkItemId], references: [id], onDelete: SetNull)
  notes            String?      @db.Text
  observationKey   String
  importedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())

  @@unique([siteResourceId, observationKey])
  @@index([siteResourceId])
}

/// Alias / désignations alternatives conservées (rien n’est supprimé)
model SiteResourceAlias {
  id               String                @id @default(cuid())
  siteResourceId   String
  siteResource     SiteResource          @relation(fields: [siteResourceId], references: [id], onDelete: Cascade)
  label            String
  normalizedLabel  String
  aliasKind        SiteResourceAliasKind @default(extraction_ouvrage)
  sourceWorkItemId String?
  sourceWorkItem   WorkItem?             @relation(fields: [sourceWorkItemId], references: [id], onDelete: SetNull)
  sourceField      SiteResourceExtractedFrom?
  sourceSnippet    String?               @db.Text
  confidenceScore  Int?
  createdAt        DateTime              @default(now())

  @@index([siteResourceId])
  @@index([normalizedLabel])
  @@index([sourceWorkItemId])
}

/// Variante technique distinguable (BA13 standard vs hydro, câbles différents…)
model SiteResourceVariant {
  id                      String                 @id @default(cuid())
  siteResourceId          String
  siteResource            SiteResource           @relation(fields: [siteResourceId], references: [id], onDelete: Cascade)
  shortName               String
  fullDescription         String                 @db.Text
  distinguishingAttributes String?               @db.Text
  orderUnit               String?
  confidenceLevel         SiteResourceConfidence @default(moyen)
  status                  SiteResourceStatus     @default(a_verifier)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([siteResourceId])
  @@index([status])
}

/// Lien N–N ouvrage bibliothèque ↔ ressource chantier
model WorkItemSiteResource {
  id               String                    @id @default(cuid())
  workItemId       String
  workItem         WorkItem                  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  siteResourceId   String
  siteResource     SiteResource              @relation(fields: [siteResourceId], references: [id], onDelete: Cascade)
  linkRole         SiteResourceLinkRole      @default(fourniture)
  extractedFrom    SiteResourceExtractedFrom @default(includedItems)
  sourceSnippet    String?                   @db.Text
  extractionRunId  String?
  extractionRun    SiteResourceExtractionRun? @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  confidenceScore  Int?
  createdAt        DateTime                  @default(now())

  @@unique([workItemId, siteResourceId, extractedFrom, sourceSnippet])
  @@index([workItemId])
  @@index([siteResourceId])
  @@index([extractionRunId])
}

/// Lot d’extraction depuis la bibliothèque d’ouvrages
model SiteResourceExtractionRun {
  id              String                        @id @default(cuid())
  label           String?
  status          SiteResourceExtractionRunStatus @default(draft)
  workItemCount   Int                           @default(0)
  candidateCount  Int                           @default(0)
  proposalCount   Int                           @default(0)
  meta            Json?
  createdByUserId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  proposals       SiteResourceGroupingProposal[]
  workItemLinks   WorkItemSiteResource[]

  @@index([status])
  @@index([createdAt])
}

/// Proposition de regroupement (validation humaine obligatoire)
model SiteResourceGroupingProposal {
  id                    String                             @id @default(cuid())
  extractionRunId       String?
  extractionRun         SiteResourceExtractionRun?         @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  proposalType          SiteResourceGroupingProposalType
  status                SiteResourceGroupingProposalStatus @default(pending)
  similarityScore       Int
  sourceLabel           String
  normalizedSourceLabel String
  targetSiteResourceId  String?
  targetSiteResource    SiteResource?                      @relation("ProposalTargetResource", fields: [targetSiteResourceId], references: [id], onDelete: SetNull)
  sourceWorkItemId      String?
  sourceWorkItem        WorkItem?                          @relation(fields: [sourceWorkItemId], references: [id], onDelete: SetNull)
  sourceField           SiteResourceExtractedFrom?
  sourceSnippet         String?                            @db.Text
  matchReasons          Json?
  createdSiteResourceId String?
  createdSiteResource   SiteResource?                      @relation("ProposalCreatedResource", fields: [createdSiteResourceId], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  reviewNote            String?                            @db.Text
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  @@index([extractionRunId])
  @@index([status])
  @@index([targetSiteResourceId])
  @@index([normalizedSourceLabel])
  @@index([sourceWorkItemId])
}

/// Document ou source métier (devis, BPU, DPGF…)
model PriceSource {
  id               String                   @id @default(cuid())
  name             String
  sourceType       BeWorkPriceDocSourceType
  clientName       String?
  projectName      String?
  projectLocation  String?
  department       String?
  dateDocument     DateTime?                @db.Date
  notes            String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  priceEntries PriceEntry[]

  @@index([sourceType])
}

/// Prix observé pour un ouvrage
model PriceEntry {
  id               String                   @id @default(cuid())
  workItemId       String
  priceSourceId    String?
  sourceName       String
  sourceType       BeWorkPriceDocSourceType
  unitPriceHT      Decimal                  @db.Decimal(14, 4)
  vatRate          Decimal                  @db.Decimal(6, 4)
  unitPriceTTC     Decimal                  @db.Decimal(14, 4)
  quantity         Decimal?                 @db.Decimal(14, 4)
  totalHT          Decimal?                 @db.Decimal(14, 4)
  totalTTC         Decimal?                 @db.Decimal(14, 4)
  region           String?
  department       String?
  projectType      String?
  qualityLevel     String?
  dateObserved     DateTime?                @db.Date
  reliabilityScore Int                      @default(3)
  notes            String?                  @db.Text
  /// Désignation complète de la variante importée (ChatGPT / collage JSON).
  variantDesignation String?                @db.Text
  /// Métadonnées structurées d’import (famille, profondeur, classe de terre, tags…).
  importMeta         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  workItem    WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  priceSource PriceSource? @relation(fields: [priceSourceId], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([sourceType])
  @@index([department])
}

// ─── BeWork Devis — projets clients & documents de chiffrage (devis / DPGF / etc.) ───

enum QuoteDocumentType {
  devis_estimatif
  dpgf_consultation
  devis_corrige
  comparatif_devis
  devis_contractuel
}

enum QuoteDocumentStatus {
  brouillon
  a_verifier
  pret_a_envoyer
  envoye
  archive
}

/// Projet client pour regrouper les documents de chiffrage
model QuoteProject {
  id                 String   @id @default(cuid())
  clientName         String
  clientEmail        String?
  clientPhone        String?
  clientType         String?  @default("professionnel")
  clientCivility     String?
  clientFirstName    String?
  clientLastName     String?
  clientCompanyName  String?
  clientAddressLine1 String?
  clientAddressLine2 String?
  clientPostalCode   String?
  clientCityName     String?
  clientLandline     String?
  clientMobile       String?
  clientFax          String?
  projectName        String
  projectAddress     String?
  projectCity        String?
  projectDepartment  String?
  projectType        String?
  notes              String?  @db.Text
  /// Émetteur du devis (entreprise qui chiffre) — affiché en en-tête PDF
  issuerCompanyName  String?
  issuerAddressLine1 String?
  issuerAddressLine2 String?
  issuerPhone        String?
  issuerEmail        String?
  issuerSiret        String?
  issuerTvaNumber    String?
  issuerApeCode      String?
  issuerInsuranceName   String?
  issuerInsurancePolicy String?
  issuerLegalMentions   String?  @db.Text
  issuerLogoPath     String?
  clientReference    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents QuoteDocument[]

  @@index([clientName])
  @@index([projectName])
}

/// Document (devis estimatif, DPGF consultation, etc.)
model QuoteDocument {
  id               String              @id @default(cuid())
  projectId        String
  project          QuoteProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentNumber   String              @unique
  documentType     QuoteDocumentType   @default(devis_estimatif)
  title            String
  status           QuoteDocumentStatus @default(brouillon)
  issueDate        DateTime            @db.Date
  validityDate     DateTime?           @db.Date
  currency         String              @default("EUR")
  globalVatRate    Decimal             @default(20) @db.Decimal(6, 4)
  subtotalHT       Decimal             @default(0) @db.Decimal(14, 4)
  totalVat         Decimal             @default(0) @db.Decimal(14, 4)
  totalTTC         Decimal             @default(0) @db.Decimal(14, 4)
  notesClient      String?             @db.Text
  internalNotes    String?             @db.Text
  legalDisclaimer  String?             @db.Text
  /// Objet du devis (affiché sous les cartes client/projet)
  quoteObject      String?             @db.Text
  /// Conditions commerciales (paiement, délais, acompte…)
  commercialConditions String?           @db.Text
  /// Réserves techniques (complément mentions légales)
  technicalReservations String?          @db.Text
  /// Options de mise en page PDF (pdfMode, designationMode, etc.)
  presentationSettings Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  lines QuoteLine[]
  dpgfAnalysisSheets DpgfAnalysisSheet[]

  @@index([projectId])
  @@index([status])
  @@index([documentType])
}

/// Ligne de document (ouvrage bibliothèque ou ligne libre)
model QuoteLine {
  id               String   @id @default(cuid())
  documentId       String
  document         QuoteDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workItemId       String?
  workItem         WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  lot              String
  family           String?
  code             String?
  title            String
  description      String   @db.Text
  unit             String
  quantity         Decimal  @db.Decimal(14, 4)
  unitPriceHT      Decimal  @db.Decimal(14, 4)
  vatRate          Decimal  @db.Decimal(6, 4)
  totalHT          Decimal  @db.Decimal(14, 4)
  totalVat         Decimal  @db.Decimal(14, 4)
  totalTTC         Decimal  @db.Decimal(14, 4)
  includedItems    String?  @db.Text
  excludedItems    String?  @db.Text
  vigilancePoints  String?  @db.Text
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([documentId])
  @@index([workItemId])
  @@index([lot])
}

/// Session Skill CCTP (génération, historique, exports)
model SkillCctpSession {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestText        String   @db.Text
  projectType        String?
  lot                String?
  location           String?
  constraints        String?  @db.Text
  detailLevel        String   @default("standard")
  availableDocuments String?  @db.Text
  normReferences     Json?
  extractedContext   String?  @db.Text
  resultMarkdown     String?  @db.Text
  usedLlm            Boolean  @default(false)
  notice             String?  @db.Text
  generationMode     String   @default("redaction")
  marketProfile      String?
  meta               Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  files SkillCctpFile[]

  @@index([userId, createdAt(sort: Desc)])
}

model SkillCctpFile {
  id            String   @id @default(cuid())
  sessionId     String
  session       SkillCctpSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind          String
  fileName      String
  mimeType      String?
  fileSize      Int
  extractedText String?  @db.Text
  storagePath   String?
  storageUrl    String?
  createdAt     DateTime @default(now())

  @@index([sessionId])
}

/// Session Skill PPSPS (analyse risques, historique, exports)
model SkillPpspsSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteName         String?
  siteAddress      String?
  detailLevel      String   @default("standard")
  generationMode   String   @default("analyse_risques")
  formSnapshot     Json
  extractedContext String?  @db.Text
  resultMarkdown   String?  @db.Text
  usedLlm          Boolean  @default(false)
  notice           String?  @db.Text
  linkedDocumentId String?
  meta             Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  files SkillPpspsFile[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
}

model SkillPpspsFile {
  id            String           @id @default(cuid())
  sessionId     String
  session       SkillPpspsSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind          String
  fileName      String
  mimeType      String?
  fileSize      Int
  extractedText String?          @db.Text
  storagePath   String?
  storageUrl    String?
  createdAt     DateTime         @default(now())

  @@index([sessionId])
}

/// Dico BTP — lexique interne : définitions, acronymes et explications par lot travaux
model BtpDictionaryTerm {
  id                 String   @id @default(cuid())
  term               String
  acronym            String?
  lotCode            String?
  lotName            String?
  family             String?
  /// Catégorie : technique, document, materiau, materiel, mise_en_oeuvre, vigilance, norme, securite
  category           String?
  shortDefinition    String   @db.Text
  beginnerExplanation String? @db.Text
  usageExample       String?  @db.Text
  /// Note / définition personnelle ajoutée par l'utilisateur pour enrichir la fiche
  personalNote       String?  @db.Text
  /// URL publique d'une image illustrative téléversée sur la fiche
  imageUrl           String?
  keywords           String[]
  synonyms           String[]
  vigilancePoints    String[]
  linkedDocuments    String[]
  /// Niveau : débutant / intermédiaire / confirmé
  level              String   @default("débutant")
  source             String?
  /// Statut : à vérifier / validé / brouillon
  status             String   @default("à vérifier")
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([term])
  @@index([lotCode])
  @@index([family])
  @@index([category])
  @@index([status])
  @@index([updatedAt])
}

// =============================================================================
// Pilotage administratif des travaux (après attribution marché)
// Rattaché à Project (chantier) et User CLIENT — pas de doublon Client/Chantier.
// =============================================================================

enum PilotageStatus {
  A_PREPARER
  EN_COURS
  SOUS_SURVEILLANCE
  BLOQUE
  TERMINE
  ARCHIVE
}

model WorksitePilotage {
  id                    String         @id @default(cuid())
  projectId             String
  clientId              String
  internalRef           String?
  lot                   String?
  corpsEtat             String?
  marketAmountHt        Decimal?       @db.Decimal(14, 2)
  notificationDate      DateTime?      @db.Date
  startDate             DateTime?      @db.Date
  contractualDurationDays Int?
  plannedEndDate        DateTime?      @db.Date
  conducteurId          String?
  assistantId           String?
  clientContactName     String?
  maitreOuvrage         String?
  maitreOeuvre          String?
  bureauControle        String?
  coordinateurSps       String?
  status                PilotageStatus @default(A_PREPARER)
  description           String?        @db.Text
  adminProgressPct      Int            @default(0)
  doeProgressPct        Int            @default(0)
  /// Score santé 0-100 (calculé) — nullable pour anciens pilotages
  healthScore           Int?
  /// CONFORME | A_SURVEILLER | EN_DIFFICULTE | CRITIQUE | TERMINE
  healthLabel           String?
  healthUpdatedAt       DateTime?
  /// ESSENTIEL | RENFORCE | COMPLET
  serviceLevel          String         @default("ESSENTIEL")
  /// Score risque contractuel 0-100 (distinct de la santé opérationnelle)
  contractRiskScore     Int?
  /// FAIBLE | MODERE | ELEVE | CRITIQUE
  contractRiskLabel     String?
  contractRiskUpdatedAt DateTime?
  createdById           String?
  archivedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?   @relation("PilotageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  conducteur User?   @relation("PilotageConducteur", fields: [conducteurId], references: [id], onDelete: SetNull)
  assistant  User?   @relation("PilotageAssistant", fields: [assistantId], references: [id], onDelete: SetNull)

  marketDocuments  PilotageMarketDocument[]
  obligations      ContractObligation[]
  requiredDocuments RequiredDocument[]
  actions          PilotageAction[]
  plans            PlanRegister[]
  doeItems         DoeItem[]
  subcontractors   PilotageSubcontractor[]
  situations       WorkSituation[]
  extraWorks       ExtraWork[]
  activities       PilotageActivity[]
  reports          PilotageReport[]
  milestones       PilotageMilestone[]
  blockers         PilotageBlocker[]
  sensitiveDeadlines PilotageSensitiveDeadline[]
  pricingAssumptions PilotagePricingAssumption[]
  handovers          PilotageHandover[]
  tradeInterfaces    PilotageTradeInterface[]
  embeddedElements   PilotageEmbeddedElement[]
  sensitiveWorks     PilotageSensitiveWork[]
  nonConformities    PilotageNonConformity[]
  delayEvents        PilotageDelayEvent[]
  meetings           PilotageMeeting[]
  photos             PilotagePhoto[]
  lessons            PilotageLesson[]
  timelineEvents     PilotageTimelineEvent[]

  @@unique([projectId])
  @@index([clientId])
  @@index([status])
  @@index([assistantId])
  @@index([conducteurId])
  @@index([archivedAt])
  @@index([plannedEndDate])
  @@index([healthLabel])
}

model PilotageMarketDocument {
  id              String    @id @default(cuid())
  pilotageId      String
  docType         String
  title           String
  version         String?
  indice          String?
  documentDate    DateTime? @db.Date
  depositedAt     DateTime  @default(now())
  emitter         String?
  status          String    @default("Reçu")
  comment         String?   @db.Text
  isCurrent       Boolean   @default(true)
  replacesId      String?
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  mimeType        String?
  uploadedById    String?
  chantierFileId  String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pilotage WorksitePilotage @relation(fields: [pilotageId], references: [id], onDelete: Cascade)
  replaces PilotageMarketDocument?  @relation("MarketDocVersions", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy PilotageMarketDocument[] @relation("MarketDocVersions")
  chantierFile ChantierFile? @relation(fields: [chantierFileId], references: [id], onDelete: SetNull)

  @@index([pilotageId, docType])
  @@index([pilotageId, isCurrent])
  @@index([status])
  @@index([chantierFileId])
}

model ContractObligation {
  id                String    @id @default(cuid())
  pilotageId        String
  title             String
  description       String?   @db.Text
  category          String    @default("Contractuel")
  sourceDocument    String?
  articleRef        String?
  pageRef           String?
  dueDate           DateTime? @db.Date
  dueRule           String?
  responsibleName   String?
  validatorName     String?
  priority          String    @default("Normale")
  status            String    @default("À préparer")
