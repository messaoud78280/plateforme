// Plateforme d'échange Client - Agence
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Utilisateurs (clients et membres de l'agence)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  emailVerified DateTime?
  civilite  String?  // Civilité : M., Mme, etc.
  role      UserRole @default(CLIENT)
  company   String?  // Raison sociale
  phone     String?
  // Adresse de facturation (coordonnées entreprise)
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingPostalCode   String?
  billingCountry      String?
  formeJuridique  String?  // SAS, EURL, SARL, SA, profession libérale, etc.
  secteurActivite String?  // e-commerce, juridique, commercial, etc.
  service         String?  // Service / département du contact
  // Signature électronique du contrat (activation compte)
  contractStatus  ContractStatus @default(PENDING)
  signedAt        DateTime?
  yousignSignatureRequestId String?  // ID de la demande Yousign
  // Facturation par actions (1 action = 12 min, 5 actions ≈ 1 h)
  subscriptionPlan   String?   // STANDARD | STANDARD_PLUS | PREMIUM | FULLTIME
  monthlyActionsTotal Int      @default(120)  // selon abonnement
  monthlyActionsUsed  Int      @default(0)    // consommées ce mois
  actionsResetAt      DateTime? // expiration des crédits en cours (J+30 après achat/crédit)
  invitedById         String?   // utilisateur qui a invité (équipe)
  teamRole            String?   // ADMIN | USER | SUPERVISEUR (si membre d'une équipe)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invitedBy           User?     @relation("TeamMembers", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers        User[]    @relation("TeamMembers")
  invitationsSent     Invitation[]
  messagesSent       Message[]  @relation("SentMessages")
  messagesReceived   Message[]  @relation("ReceivedMessages")
  projects           Project[]  @relation("ClientProjects")
  projectsAssigned   Project[]  @relation("AssignedProjects")
  documents          Document[]
  tasks              Task[]
  tasksAssigned      Task[]     @relation("AssignedTasks")
  taskComments       TaskComment[]
  taskMessagesSent   TaskMessage[]  @relation("TaskMessagesSent")
  taskMessagesReceived TaskMessage[] @relation("TaskMessagesReceived")
  directMessagesSent   DirectMessage[] @relation("DirectMessagesSent")
  directMessagesReceived DirectMessage[] @relation("DirectMessagesReceived")
  notifications      Notification[]
  activities         Activity[]
  alerts             Alert[]
  appointmentsOrganized Appointment[] @relation("AppointmentOrganizer")
  appointmentsAsClient  Appointment[] @relation("AppointmentClient")
  reportsAuthored       Report[]      @relation("ReportAuthor")
  reportComments        ReportComment[]
  subscriptions         Subscription[]
  payments              Payment[]
  actionsTransactions   ActionsTransaction[]
  skillCctpSessions     SkillCctpSession[]
  skillPpspsSessions    SkillPpspsSession[]
  chantierFiles         ChantierFile[]
  chantierFilesAdded    ChantierFile[] @relation("ChantierFileAddedBy")

  // NextAuth (magic link)
  accounts              Account[]
  sessions              Session[]
}

// NextAuth — comptes (OAuth, etc.)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth — sessions (si strategy database)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth — tokens de vérification (magic link)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
// Invitation à rejoindre l'équipe d'un client
model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        String   // ADMIN | USER | SUPERVISEUR
  invitedById String
  token       String   @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([invitedById])
  @@index([email, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

// Formule / abonnement client (historique et état)
model Subscription {
  id         String   @id @default(cuid())
  userId     String
  planKey    String   // DECOUVERTE | STANDARD | STANDARD_PLUS | PREMIUM
  status     SubscriptionStatus @default(ACTIVE)
  startedAt DateTime @default(now())
  renewsAt  DateTime?  // prochain renouvellement (formules mensuelles)
  endedAt   DateTime?  // fin (résiliation ou one-shot)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  PENDING   // en attente de paiement
  ACTIVE    // actif
  EXPIRED   // expiré
  CANCELLED // résilié
}

// Paiement (historique)
model Payment {
  id               String        @id @default(cuid())
  userId           String
  subscriptionId   String?
  planKey          String
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("EUR")
  status           PaymentStatus @default(PENDING)
  actionsCredited  Int           @default(0)
  externalId       String?       // Stripe payment intent id, etc.
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Historique des mouvements d'actions (crédit / débit)
model ActionsTransaction {
  id           String              @id @default(cuid())
  userId       String
  type         ActionsTransactionType
  source       ActionsTransactionSource
  amount       Int                 // positif = crédit, négatif = débit
  description  String?
  referenceId  String?             // id Payment ou autre
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum ActionsTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

enum ActionsTransactionSource {
  SUBSCRIPTION   // crédit souscription
  ONE_TIME       // offre Découverte
  RENEWAL        // renouvellement mensuel
  ADMIN          // ajustement manuel
  TASK_DEDUCTION // débit tâche terminée
}

enum UserRole {
  CLIENT  // Client
  AGENCE  // Agent agence (opérationnel)
  MANAGER // Gérant de l'agence
  AGENT   // Assistante virtuelle (exécution des tâches)
}

enum ContractStatus {
  PENDING  // En attente de signature
  SIGNED   // Contrat signé électroniquement
}

// Projets / chantiers (liés à un client) – dossier chantier numérique
model Project {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        ProjectStatus  @default(EN_COURS)
  clientId      String
  assignedToId  String?        // agent (User rôle AGENCE) en charge du projet
  dateSouhaitee DateTime?      // date souhaitée pour le début
  deadline      DateTime?      // deadline d'exécution
  urgency       ProjectUrgency @default(MOYENNE)
  notes         String?        // instructions ou détails administratifs
  // Champs dossier chantier BTP
  siteAddress       String?
  siteCity          String?
  internalManager   String?    // responsable interne entreprise
  signedQuoteAmount Decimal?   @db.Decimal(14, 2)
  plannedStartDate  DateTime?  @db.Date
  plannedEndDate    DateTime?  @db.Date
  chantierStatus    ChantierStatus @default(ETUDE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  client     User       @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo User?      @relation("AssignedProjects", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]
  documents  Document[]
  tasks      Task[]
  invoices   Invoice[]
  metrics    Metric[]
  activities Activity[]
  appointments Appointment[]
  reports Report[]
  skillPpspsSessions SkillPpspsSession[]
  chantierFolders ChantierFolder[]
  chantierFiles   ChantierFile[]
}

// Statut métier du chantier (pilotage conducteur de travaux)
enum ChantierStatus {
  ETUDE
  EN_COURS
  EN_ATTENTE
  RECEPTION
  TERMINE
}

// Rubrique du classeur chantier (01 Devis, 02 Contrats, …)
model ChantierFolder {
  id        String   @id @default(cuid())
  projectId String
  code      String   // ex. "01"
  label     String   // ex. "Devis & avenants"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files   ChantierFile[]

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
}

// Fichier ou pièce attendue dans une rubrique chantier
model ChantierFile {
  id           String             @id @default(cuid())
  projectId    String
  folderId     String
  clientId     String
  name         String
  fileUrl      String?            // null si statut MANQUANT (pièce attendue)
  fileSize     Int?
  mimeType     String?
  documentType String?            // type libellé BTP (BL, assurance ST, CR n°12…)
  status       ChantierFileStatus @default(RECU)
  comment      String?
  addedById    String?
  // Préparation IA (classification, résumé, détection manquants) — non utilisé en V1
  aiSummary           String?   @db.Text
  aiClassifiedAt      DateTime?
  aiSuggestedFolderId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder   ChantierFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  client   User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addedBy  User?          @relation("ChantierFileAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([projectId, folderId])
  @@index([clientId])
  @@index([status])
}

enum ChantierFileStatus {
  RECU
  A_VERIFIER
  VALIDE
  MANQUANT
  A_RELANCER
}

enum ProjectStatus {
  NOUVEAU
  EN_COURS
  EN_ATTENTE
  TERMINE
}

enum ProjectUrgency {
  BASSE
  MOYENNE
  HAUTE
  URGENTE
}

// Messages entre client et agence
model Message {
  id         String   @id @default(cuid())
  content    String
  projectId  String
  senderId   String
  receiverId String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender   User    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

// Documents déposés par les clients (optionnellement liés à un projet ou une tâche)
model Document {
  id        String   @id @default(cuid())
  name      String
  category  DocumentCategory @default(AUTRE)
  fileUrl   String
  fileSize  Int      // en octets
  mimeType  String?
  status    DocumentStatus @default(EN_ATTENTE)
  clientId  String
  projectId String?
  taskId    String?  // pièce jointe d'une tâche
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

enum DocumentCategory {
  FACTURE
  CONTRAT
  RH
  FISCAL
  AUTRE
}

enum DocumentStatus {
  EN_ATTENTE
  EN_TRAITEMENT
  TRAITE
  ARCHIVE
}

// Tâches administratives (optionnellement liées à un projet)
model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(NOUVEAU)
  clientId       String
  projectId      String?   // projet auquel la tâche se rapporte (optionnel)
  category         String?   // Gestion d'emails, Recherche, Organisation, etc.
  priority         String?   // STANDARD | PRIORITAIRE | URGENT
  desiredDate      DateTime? @db.Date  // date souhaitée par le client
  // estimatedActions String?   // estimation initiale — désactivé si colonne absente en prod ; réactiver après migration
  assignedToId   String?   // agent (User rôle AGENCE) assigné par l'agence après prise en charge
  agencyNotes    String?   // notes de l'agence pour l'agent (consignes, rappels)
  correctionNote String?   // note quand le responsable demande une correction
  validatedAt    DateTime? // date de validation du travail par l'agence
  completedAt    DateTime?
  timeSpentMinutes Int?    // temps réel passé (minutes) — renseigné par l'agent
  actionsUsed      Int?    // actions déduites (ceil(min/10), min 1)
  creditsDeductedAt DateTime? // date de débit effectif sur le compteur client
  clientReport     String?   // compte rendu envoyé au client
  clientReportSentAt DateTime?
  clientReportSentById String?
  // Mémoire des missions (contacts et fournisseurs pour relance)
  contactsJson    Json?    // [{ name, email, role }]
  suppliersJson   Json?    // [{ name, contact }]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client     User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo User?        @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments   TaskComment[]
  documents  Document[]
  taskMessages TaskMessage[]
}

enum TaskStatus {
  NOUVEAU         // Nouvelle demande (client vient de créer)
  EN_ATTENTE      // En attente (avant assignation ou en attente d'info)
  ASSIGNEE        // Agent assigné par la gérante
  EN_ANALYSE      // Agent analyse la demande
  EN_COURS        // En cours de traitement
  EN_ATTENTE_INFO // En attente d'information (client ou autre)
  A_VALIDER       // Travail terminé, en attente de validation gérante
  COMPLETE        // Terminée (validée par la gérante)
}

// Messages directs entre gérants et agents (sans mission)
model DirectMessage {
  id             String   @id @default(cuid())
  senderId       String
  receiverId     String
  content        String
  attachmentsJson Json?   // [{ name, fileUrl, fileSize, mimeType }]
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  sender   User @relation("DirectMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("DirectMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

// Messages sur une tâche (client ↔ agent quand assigné, ou interne gérante ↔ agent)
model TaskMessage {
  id         String   @id @default(cuid())
  taskId     String
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  isInternal Boolean  @default(false)  // true = visible uniquement gérante/agent
  createdAt  DateTime @default(now())

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender  User @relation("TaskMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("TaskMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([receiverId])
}

// Commentaires sur tâches (optionnellement internes = invisibles client)
model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Notifications pour tous les rôles (client, agent, gérante)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // NEW_TASK, TASK_ASSIGNED, MESSAGE_RECEIVED, TASK_COMPLETED, TASK_TO_VALIDATE, etc.
  title     String
  message   String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

// Factures
model Invoice {
  id            String        @id @default(cuid())
  projectId     String
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime
  paidDate      DateTime?
  createdAt     DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

// Métriques / KPIs (pour rapports et simulation)
model Metric {
  id         String   @id @default(cuid())
  projectId  String
  metricDate DateTime
  metricType String   // social_media, support_emails, response_time, etc.
  metricData Json     // données flexibles
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Timeline activité récente
model Activity {
  id        String   @id @default(cuid())
  type      String   // DOCUMENT_UPLOADED, TASK_COMPLETED, MESSAGE_SENT, etc.
  title     String
  detail    String?
  clientId  String
  projectId String?  // optionnel : lier à un projet
  metadata  Json?    // données supplémentaires
  createdAt DateTime @default(now())

  client  User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// Alertes importantes (optionnellement avec lien d'action)
model Alert {
  id        String   @id @default(cuid())
  title     String
  message   String
  level     AlertLevel @default(INFO)
  clientId  String
  actionUrl String?   // lien direct (ex. vers le projet pour un nouveau message)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum AlertLevel {
  INFO
  WARNING
  URGENT
}

// Demandes de contact / RDV depuis le formulaire public
model ContactRequest {
  id                  String            @id @default(cuid())
  structure           String
  denominationSociale String?
  contactName         String
  email               String
  phone               String?
  formule             String?
  message             String?
  rdvDate             DateTime?         @db.Date
  rdvTime             String?           // "09:00", "09:30", ...
  sector              String?
  howKnown            String?
  marketType          String?
  tradeActivity       String?
  mainNeed            String?
  consent             Boolean           @default(false)
  source              String?           @default("homepage_contact_form")
  status              ContactRequestStatus @default(NOUVEAU)
  createdAt           DateTime          @default(now())

  @@index([rdvDate, rdvTime])
  @@index([status])
}

enum ContactRequestStatus {
  NOUVEAU
  CONFIRME
  ANNULE
}

// Rendez-vous (calendrier type Calendly)
model Appointment {
  id           String   @id @default(cuid())
  title        String
  startAt      DateTime
  endAt        DateTime
  organizerId  String   // User agence/gérant qui organise
  clientId     String?  // User client (si connecté)
  clientEmail  String?  // Email si prise de RDV externe
  clientName   String?
  projectId    String?
  notes        String?  @db.Text
  comments     Json?    // [{ userId, text, createdAt }]
  recurrence   String?  // "NONE" | "WEEKLY" | "BIWEEKLY" | "MONTHLY"
  recurrenceEndAt DateTime?
  reminderSentAt  DateTime?
  status       AppointmentStatus @default(CONFIRME)
  contactRequestId String?  @unique  // Si issu d'une demande de contact
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizer    User     @relation("AppointmentOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  client       User?    @relation("AppointmentClient", fields: [clientId], references: [id], onDelete: SetNull)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  attachments  AppointmentAttachment[]
}

enum AppointmentStatus {
  CONFIRME
  ANNULE
  TERMINE
}

// Pièces jointes sur un rendez-vous
model AppointmentAttachment {
  id            String @id @default(cuid())
  appointmentId String
  name          String
  fileUrl       String
  fileSize      Int
  mimeType      String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// Reporting hebdomadaire ou journalier entre client et agent
model Report {
  id          String      @id @default(cuid())
  projectId   String
  authorId    String
  reportType  ReportType  @default(HEBDOMADAIRE)
  periodStart DateTime    @db.Date  // début de la période couverte
  periodEnd   DateTime    @db.Date  // fin de la période couverte
  content     String      @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User        @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments ReportAttachment[]
  comments    ReportComment[]
}

enum ReportType {
  JOURNALIER
  HEBDOMADAIRE
}

// Pièces jointes sur un rapport
model ReportAttachment {
  id        String   @id @default(cuid())
  reportId  String
  name      String
  fileUrl   String
  fileSize  Int
  mimeType  String?
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// Commentaires sur un rapport
model ReportComment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── BeWork Devis — bibliothèque interne (référentiel ouvrages / prix / sources) ───

enum WorkItemQualityLevel {
  standard
  confort
  premium
}

enum WorkItemStatus {
  brouillon
  a_completer
  a_verifier
  valide
  archive
}

enum WorkItemItemType {
  ouvrage_technique
  etude_controle
  prestation_administrative
  garantie_assurance
  frais_annexe
}

/// Statut de regroupement doublons (aucune suppression — fusion réversible)
enum WorkItemMergeStatus {
  unique
  canonical
  merged
}

enum WorkItemMergeProposalStatus {
  pending
  approved
  rejected
}

enum BeWorkPriceDocSourceType {
  devis
  bpu
  dpgf
  marche_public
  estimation_interne
  autre
}

/// Ouvrage BTP de la bibliothèque interne
model WorkItem {
  id                   String               @id @default(cuid())
  code                 String               @unique
  lot                  String
  subLot               String?
  family               String?
  title                String
  shortDescription     String?              @db.Text
  fullDescription      String               @db.Text
  unit                 String
  qualityLevel         WorkItemQualityLevel @default(standard)
  technicalReference   String?
  includedItems        String?              @db.Text
  excludedItems        String?              @db.Text
  vigilancePoints      String?              @db.Text
  clientQuestions      String?              @db.Text
  companyQuestions     String?              @db.Text
  internalNotes        String?              @db.Text
  status               WorkItemStatus       @default(brouillon)
  itemType             WorkItemItemType     @default(ouvrage_technique)
  /// Code ou libellé court de famille BeWork (ex. TER, CAR) — lexique interne
  familyCode           String?
  /// Ancien code métier / import (ex. BW-MARTIN-15-1)
  sourceCode           String?
  /// Référence de ligne dans la source (ex. 15.1)
  sourceLine           String?
  /// Clé normalisée pour détection doublons (désignation)
  normalizedDesignation String?
  /// Fiche principale si cette ligne est une variante fusionnée
  canonicalWorkItemId  String?
  canonicalWorkItem    WorkItem?            @relation("WorkItemDuplicateGroup", fields: [canonicalWorkItemId], references: [id], onDelete: SetNull)
  mergedVariants       WorkItem[]           @relation("WorkItemDuplicateGroup")
  mergeStatus          WorkItemMergeStatus  @default(unique)
  mergedAt             DateTime?
  mergeNote            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  priceEntries              PriceEntry[]
  siteResourcePriceObservations SiteResourcePriceObservation[]
  quoteLines                QuoteLine[]
  siteResourceLinks         WorkItemSiteResource[]
  siteResourceAliases       SiteResourceAlias[]
  siteResourceGroupingProposals SiteResourceGroupingProposal[]
  mergeProposalsAsCanonical WorkItemMergeProposal[] @relation("MergeProposalCanonical")
  mergeProposalMembers      WorkItemMergeProposalMember[]

  @@index([lot])
  @@index([status])
  @@index([unit])
  @@index([itemType])
  @@index([familyCode])
  @@index([normalizedDesignation])
  @@index([canonicalWorkItemId])
  @@index([mergeStatus])
}

/// Proposition de fusion de doublons ouvrages (validation humaine)
model WorkItemMergeProposal {
  id                    String                      @id @default(cuid())
  status                WorkItemMergeProposalStatus   @default(pending)
  proposedCanonicalId   String?
  proposedCanonical     WorkItem?                   @relation("MergeProposalCanonical", fields: [proposedCanonicalId], references: [id], onDelete: SetNull)
  canonicalDesignation  String
  normalizedKey         String
  similarityScore       Int
  matchReasons          Json?
  mergeMode             String                      @default("manual_review")
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  members               WorkItemMergeProposalMember[]

  @@index([status])
  @@index([normalizedKey])
  @@index([similarityScore])
}

/// Lien proposition ↔ ouvrage candidat (données conservées)
model WorkItemMergeProposalMember {
  id           String                @id @default(cuid())
  proposalId   String
  proposal     WorkItemMergeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  workItemId   String
  workItem     WorkItem              @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  isCanonical  Boolean               @default(false)
  designation  String
  similarityScore Int?

  @@unique([proposalId, workItemId])
  @@index([workItemId])
}

// ─── BeWork Devis — ressources chantier (matériaux, consommables, locations…) ───

enum SiteResourceType {
  materiaux
  consommables
  location_engin
  location_outillage
  equipements
  services
}

enum SiteResourceStatus {
  brouillon
  a_verifier
  valide
  archive
  fusionne
}

enum SiteResourceConfidence {
  faible
  moyen
  eleve
}

enum SiteResourceAliasKind {
  synonyme
  extraction_ouvrage
  fournisseur
  orthographe
  ancien_libelle
  court
  variante_libelle
}

enum SiteResourceLinkRole {
  materiau_principal
  fourniture
  consommable
  location
  equipement
  service
  autre
}

enum SiteResourceExtractedFrom {
  title
  includedItems
  fullDescription
  manuel
}

enum SiteResourceGroupingProposalType {
  merge_as_alias
  create_variant
  new_resource
  keep_separate
  ignore
}

enum SiteResourceGroupingProposalStatus {
  pending
  approved
  rejected
}

enum SiteResourceExtractionRunStatus {
  draft
  preview
  applied
  cancelled
}

/// Fiche ressource chantier principale (regroupement intelligent, sans perte d’alias)
model SiteResource {
  id                      String                   @id @default(cuid())
  shortName               String
  fullDescription         String                   @db.Text
  resourceType            SiteResourceType
  family                  String
  subFamily               String?
  orderUnit               String
  siteUsage               String?                  @db.Text
  mainCharacteristics     String?                  @db.Text
  characteristicsToVerify String?                  @db.Text
  businessNotes           String?                  @db.Text
  confidenceLevel         SiteResourceConfidence   @default(moyen)
  status                  SiteResourceStatus       @default(brouillon)
  normalizedDesignation   String?
  mergedIntoId            String?
  mergedInto              SiteResource?            @relation("SiteResourceMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom              SiteResource[]           @relation("SiteResourceMerge")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  aliases            SiteResourceAlias[]
  variants           SiteResourceVariant[]
  priceObservations  SiteResourcePriceObservation[]
  workItemLinks      WorkItemSiteResource[]
  groupingProposals SiteResourceGroupingProposal[] @relation("ProposalTargetResource")
  groupingProposalsAsSource SiteResourceGroupingProposal[] @relation("ProposalCreatedResource")

  @@index([resourceType, family, subFamily])
  @@index([status])
  @@index([shortName])
  @@index([normalizedDesignation])
  @@index([mergedIntoId])
}

/// Prix observés rattachés à une fiche ressource (conservés lors des fusions)
model SiteResourcePriceObservation {
  id               String       @id @default(cuid())
  siteResourceId   String
  siteResource     SiteResource @relation(fields: [siteResourceId], references: [id], onDelete: Cascade)
  amountHT         Decimal      @db.Decimal(12, 4)
  orderUnit        String       @default("u")
  sourceName       String?
  sourceWorkItemId String?
  sourceWorkItem   WorkItem?    @relation(fields: [sourceWorkItemId], references: [id], onDelete: SetNull)
  notes            String?      @db.Text
  observationKey   String
  importedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())

  @@unique([siteResourceId, observationKey])
  @@index([siteResourceId])
}

/// Alias / désignations alternatives conservées (rien n’est supprimé)
model SiteResourceAlias {
  id               String                @id @default(cuid())
  siteResourceId   String
  siteResource     SiteResource          @relation(fields: [siteResourceId], references: [id], onDelete: Cascade)
  label            String
  normalizedLabel  String
  aliasKind        SiteResourceAliasKind @default(extraction_ouvrage)
  sourceWorkItemId String?
  sourceWorkItem   WorkItem?             @relation(fields: [sourceWorkItemId], references: [id], onDelete: SetNull)
  sourceField      SiteResourceExtractedFrom?
  sourceSnippet    String?               @db.Text
  confidenceScore  Int?
  createdAt        DateTime              @default(now())

  @@index([siteResourceId])
  @@index([normalizedLabel])
  @@index([sourceWorkItemId])
}

/// Variante technique distinguable (BA13 standard vs hydro, câbles différents…)
model SiteResourceVariant {
  id                      String                 @id @default(cuid())
  siteResourceId          String
  siteResource            SiteResource           @relation(fields: [siteResourceId], references: [id], onDelete: Cascade)
  shortName               String
  fullDescription         String                 @db.Text
  distinguishingAttributes String?               @db.Text
  orderUnit               String?
  confidenceLevel         SiteResourceConfidence @default(moyen)
  status                  SiteResourceStatus     @default(a_verifier)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([siteResourceId])
  @@index([status])
}

/// Lien N–N ouvrage bibliothèque ↔ ressource chantier
model WorkItemSiteResource {
  id               String                    @id @default(cuid())
  workItemId       String
  workItem         WorkItem                  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  siteResourceId   String
  siteResource     SiteResource              @relation(fields: [siteResourceId], references: [id], onDelete: Cascade)
  linkRole         SiteResourceLinkRole      @default(fourniture)
  extractedFrom    SiteResourceExtractedFrom @default(includedItems)
  sourceSnippet    String?                   @db.Text
  extractionRunId  String?
  extractionRun    SiteResourceExtractionRun? @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  confidenceScore  Int?
  createdAt        DateTime                  @default(now())

  @@unique([workItemId, siteResourceId, extractedFrom, sourceSnippet])
  @@index([workItemId])
  @@index([siteResourceId])
  @@index([extractionRunId])
}

/// Lot d’extraction depuis la bibliothèque d’ouvrages
model SiteResourceExtractionRun {
  id              String                        @id @default(cuid())
  label           String?
  status          SiteResourceExtractionRunStatus @default(draft)
  workItemCount   Int                           @default(0)
  candidateCount  Int                           @default(0)
  proposalCount   Int                           @default(0)
  meta            Json?
  createdByUserId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  proposals       SiteResourceGroupingProposal[]
  workItemLinks   WorkItemSiteResource[]

  @@index([status])
  @@index([createdAt])
}

/// Proposition de regroupement (validation humaine obligatoire)
model SiteResourceGroupingProposal {
  id                    String                             @id @default(cuid())
  extractionRunId       String?
  extractionRun         SiteResourceExtractionRun?         @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  proposalType          SiteResourceGroupingProposalType
  status                SiteResourceGroupingProposalStatus @default(pending)
  similarityScore       Int
  sourceLabel           String
  normalizedSourceLabel String
  targetSiteResourceId  String?
  targetSiteResource    SiteResource?                      @relation("ProposalTargetResource", fields: [targetSiteResourceId], references: [id], onDelete: SetNull)
  sourceWorkItemId      String?
  sourceWorkItem        WorkItem?                          @relation(fields: [sourceWorkItemId], references: [id], onDelete: SetNull)
  sourceField           SiteResourceExtractedFrom?
  sourceSnippet         String?                            @db.Text
  matchReasons          Json?
  createdSiteResourceId String?
  createdSiteResource   SiteResource?                      @relation("ProposalCreatedResource", fields: [createdSiteResourceId], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  reviewNote            String?                            @db.Text
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  @@index([extractionRunId])
  @@index([status])
  @@index([targetSiteResourceId])
  @@index([normalizedSourceLabel])
  @@index([sourceWorkItemId])
}

/// Document ou source métier (devis, BPU, DPGF…)
model PriceSource {
  id               String                   @id @default(cuid())
  name             String
  sourceType       BeWorkPriceDocSourceType
  clientName       String?
  projectName      String?
  projectLocation  String?
  department       String?
  dateDocument     DateTime?                @db.Date
  notes            String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  priceEntries PriceEntry[]

  @@index([sourceType])
}

/// Prix observé pour un ouvrage
model PriceEntry {
  id               String                   @id @default(cuid())
  workItemId       String
  priceSourceId    String?
  sourceName       String
  sourceType       BeWorkPriceDocSourceType
  unitPriceHT      Decimal                  @db.Decimal(14, 4)
  vatRate          Decimal                  @db.Decimal(6, 4)
  unitPriceTTC     Decimal                  @db.Decimal(14, 4)
  quantity         Decimal?                 @db.Decimal(14, 4)
  totalHT          Decimal?                 @db.Decimal(14, 4)
  totalTTC         Decimal?                 @db.Decimal(14, 4)
  region           String?
  department       String?
  projectType      String?
  qualityLevel     String?
  dateObserved     DateTime?                @db.Date
  reliabilityScore Int                      @default(3)
  notes            String?                  @db.Text
  /// Désignation complète de la variante importée (ChatGPT / collage JSON).
  variantDesignation String?                @db.Text
  /// Métadonnées structurées d’import (famille, profondeur, classe de terre, tags…).
  importMeta         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  workItem    WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  priceSource PriceSource? @relation(fields: [priceSourceId], references: [id], onDelete: SetNull)

  @@index([workItemId])
  @@index([sourceType])
  @@index([department])
}

// ─── BeWork Devis — projets clients & documents de chiffrage (devis / DPGF / etc.) ───

enum QuoteDocumentType {
  devis_estimatif
  dpgf_consultation
  devis_corrige
  comparatif_devis
  devis_contractuel
}

enum QuoteDocumentStatus {
  brouillon
  a_verifier
  pret_a_envoyer
  envoye
  archive
}

/// Projet client pour regrouper les documents de chiffrage
model QuoteProject {
  id                 String   @id @default(cuid())
  clientName         String
  clientEmail        String?
  clientPhone        String?
  clientType         String?  @default("professionnel")
  clientCivility     String?
  clientFirstName    String?
  clientLastName     String?
  clientCompanyName  String?
  clientAddressLine1 String?
  clientAddressLine2 String?
  clientPostalCode   String?
  clientCityName     String?
  clientLandline     String?
  clientMobile       String?
  clientFax          String?
  projectName        String
  projectAddress     String?
  projectCity        String?
  projectDepartment  String?
  projectType        String?
  notes              String?  @db.Text
  /// Émetteur du devis (entreprise qui chiffre) — affiché en en-tête PDF
  issuerCompanyName  String?
  issuerAddressLine1 String?
  issuerAddressLine2 String?
  issuerPhone        String?
  issuerEmail        String?
  issuerSiret        String?
  issuerTvaNumber    String?
  issuerApeCode      String?
  issuerInsuranceName   String?
  issuerInsurancePolicy String?
  issuerLegalMentions   String?  @db.Text
  issuerLogoPath     String?
  clientReference    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents QuoteDocument[]

  @@index([clientName])
  @@index([projectName])
}

/// Document (devis estimatif, DPGF consultation, etc.)
model QuoteDocument {
  id               String              @id @default(cuid())
  projectId        String
  project          QuoteProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentNumber   String              @unique
  documentType     QuoteDocumentType   @default(devis_estimatif)
  title            String
  status           QuoteDocumentStatus @default(brouillon)
  issueDate        DateTime            @db.Date
  validityDate     DateTime?           @db.Date
  currency         String              @default("EUR")
  globalVatRate    Decimal             @default(20) @db.Decimal(6, 4)
  subtotalHT       Decimal             @default(0) @db.Decimal(14, 4)
  totalVat         Decimal             @default(0) @db.Decimal(14, 4)
  totalTTC         Decimal             @default(0) @db.Decimal(14, 4)
  notesClient      String?             @db.Text
  internalNotes    String?             @db.Text
  legalDisclaimer  String?             @db.Text
  /// Objet du devis (affiché sous les cartes client/projet)
  quoteObject      String?             @db.Text
  /// Conditions commerciales (paiement, délais, acompte…)
  commercialConditions String?           @db.Text
  /// Réserves techniques (complément mentions légales)
  technicalReservations String?          @db.Text
  /// Options de mise en page PDF (pdfMode, designationMode, etc.)
  presentationSettings Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  lines QuoteLine[]

  @@index([projectId])
  @@index([status])
  @@index([documentType])
}

/// Ligne de document (ouvrage bibliothèque ou ligne libre)
model QuoteLine {
  id               String   @id @default(cuid())
  documentId       String
  document         QuoteDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workItemId       String?
  workItem         WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  lot              String
  family           String?
  code             String?
  title            String
  description      String   @db.Text
  unit             String
  quantity         Decimal  @db.Decimal(14, 4)
  unitPriceHT      Decimal  @db.Decimal(14, 4)
  vatRate          Decimal  @db.Decimal(6, 4)
  totalHT          Decimal  @db.Decimal(14, 4)
  totalVat         Decimal  @db.Decimal(14, 4)
  totalTTC         Decimal  @db.Decimal(14, 4)
  includedItems    String?  @db.Text
  excludedItems    String?  @db.Text
  vigilancePoints  String?  @db.Text
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([documentId])
  @@index([workItemId])
  @@index([lot])
}

/// Session Skill CCTP (génération, historique, exports)
model SkillCctpSession {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestText        String   @db.Text
  projectType        String?
  lot                String?
  location           String?
  constraints        String?  @db.Text
  detailLevel        String   @default("standard")
  availableDocuments String?  @db.Text
  normReferences     Json?
  extractedContext   String?  @db.Text
  resultMarkdown     String?  @db.Text
  usedLlm            Boolean  @default(false)
  notice             String?  @db.Text
  generationMode     String   @default("redaction")
  marketProfile      String?
  meta               Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  files SkillCctpFile[]

  @@index([userId, createdAt(sort: Desc)])
}

model SkillCctpFile {
  id            String   @id @default(cuid())
  sessionId     String
  session       SkillCctpSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind          String
  fileName      String
  mimeType      String?
  fileSize      Int
  extractedText String?  @db.Text
  storagePath   String?
  storageUrl    String?
  createdAt     DateTime @default(now())

  @@index([sessionId])
}

/// Session Skill PPSPS (analyse risques, historique, exports)
model SkillPpspsSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteName         String?
  siteAddress      String?
  detailLevel      String   @default("standard")
  generationMode   String   @default("analyse_risques")
  formSnapshot     Json
  extractedContext String?  @db.Text
  resultMarkdown   String?  @db.Text
  usedLlm          Boolean  @default(false)
  notice           String?  @db.Text
  linkedDocumentId String?
  meta             Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  files SkillPpspsFile[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
}

model SkillPpspsFile {
  id            String           @id @default(cuid())
  sessionId     String
  session       SkillPpspsSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind          String
  fileName      String
  mimeType      String?
  fileSize      Int
  extractedText String?          @db.Text
  storagePath   String?
  storageUrl    String?
  createdAt     DateTime         @default(now())

  @@index([sessionId])
}
