{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20"
  },
  "buildAptPackages": ["libreoffice-nogui", "fontconfig", "fonts-liberation"],
  "steps": {
    "build": {
      "commands": ["npm run build"]
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "aptPackages": ["libreoffice-nogui", "fontconfig", "fonts-liberation"]
  }
}
