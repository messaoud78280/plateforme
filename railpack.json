{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20"
  },
  "buildAptPackages": ["libreoffice-nogui", "fontconfig", "fonts-liberation"],
  "steps": {
    "build": {
      "commands": ["npm run build"],
      "variables": {
        "NODE_OPTIONS": "--max-old-space-size=8192",
        "BEWORK_BUILD_HEAP_MB": "8192"
      }
    }
  },
  "deploy": {
    "startCommand": "bash scripts/start-production.sh",
    "aptPackages": ["libreoffice-nogui", "fontconfig", "fonts-liberation"]
  }
}
