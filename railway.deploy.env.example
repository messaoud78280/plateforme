# Copiez ce fichier en .env.railway (non versionné) :
#   cp railway.deploy.env.example .env.railway
#
# Token : Railway → projet « plateforme » → Settings → Tokens → Create

RAILWAY_TOKEN="collez_votre_project_token_ici"

# Optionnel (valeurs par défaut ci-dessous)
RAILWAY_SERVICE=plateforme
RAILWAY_ENVIRONMENT=production
